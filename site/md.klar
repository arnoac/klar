// Markdown to std.html values: the subset the Klar docs are written in.
//
// Blocks: # headings (with anchors), paragraphs, ``` fenced code (klar blocks are highlighted), * / - and 1.
// lists (continuation lines indented), | tables |, > quotes, <!-- comments --> (dropped).
// Inline: `code`, **bold**, *emphasis*, [links](url) and backslash escapes. Text is always escaped: there is
// no raw HTML, so a page can never inject markup.

use std.html { Html, text, el, p, a, h1, h2, h3, h4, ul, ol, li, pre, code, strong, em, table, thead, tbody, tr, th, td,
  blockquote, div, class, id, href, attr, Attr }
use highlight { highlight_klar }

// A heading, for a page's table of contents.
struct MdHeading { level: int, title: str, anchor: str }

// How links are rewritten: a link to one of these targets (e.g. "klar/SPEC.md") goes to the page instead.
struct MdLink { target: str, page: str }

// ---- inline

fn md_is_punct(c: str) -> bool { return contains(chars(r"\`*_[]()#|<>!-.{}+"), c) }

// The index of the first `needle` (a sequence of 1-char strings) at or after `from`.
fn md_find(cs: list[str], needle: str, from: int) -> Option[int] {
  let ns = chars(needle)
  let n = len(cs)
  let m = len(ns)
  var i = from
  while i + m <= n {
    if cs[i] == ns[0] and (m == 1 or join(slice(cs, i, i + m), "") == needle) {
      return Some(i)
    }
    i = i + 1
  }
  return None
}

fn md_flush(out: list[Html[unit]], buf: str) -> list[Html[unit]] {
  return if buf == "" then out else push(out, text(buf))
}

fn md_url(url: str, links: list[MdLink]) -> str {
  return match find(links, fn(l) => l.target == url or ends_with(url, "/" + l.target)) {
    Some(l) => l.page,
    None => url,
  }
}

// Inline markup of one paragraph, heading or cell.
fn md_inline(s: str, links: list[MdLink]) -> list[Html[unit]] {
  let cs = chars(s)
  let n = len(cs)
  var out: list[Html[unit]] = []
  var buf = ""
  var i = 0
  while i < n {
    let c = cs[i]
    var done = false
    if c == "\\" and i + 1 < n and md_is_punct(cs[i + 1]) {
      buf = buf + cs[i + 1]
      i = i + 2
      done = true
    } else if c == "`" {
      match md_find(cs, "`", i + 1) {
        Some(j) => {
          out = push(md_flush(out, buf), code([], [text(join(slice(cs, i + 1, j), ""))]))
          buf = ""
          i = j + 1
          done = true
        }
        None => {}
      }
    } else if c == "*" and i + 1 < n and cs[i + 1] == "*" {
      match md_find(cs, "**", i + 2) {
        Some(j) => {
          out = push(md_flush(out, buf), strong([], md_inline(join(slice(cs, i + 2, j), ""), links)))
          buf = ""
          i = j + 2
          done = true
        }
        None => {}
      }
    } else if (c == "*" or c == "_") and i + 1 < n and cs[i + 1] != " " and (i == 0 or not md_is_wordy(cs[i - 1])) {
      match md_find(cs, c, i + 1) {
        Some(j) => {
          if j > i + 1 and cs[j - 1] != " " and (j + 1 >= n or not md_is_wordy(cs[j + 1])) {
            out = push(md_flush(out, buf), em([], md_inline(join(slice(cs, i + 1, j), ""), links)))
            buf = ""
            i = j + 1
            done = true
          }
        }
        None => {}
      }
    } else if c == "[" {
      match md_find(cs, "](", i + 1) {
        Some(j) => {
          match md_find(cs, ")", j + 2) {
            Some(k) => {
              let label = join(slice(cs, i + 1, j), "")
              let url = md_url(join(slice(cs, j + 2, k), ""), links)
              out = push(md_flush(out, buf), a([href(url)], md_inline(label, links)))
              buf = ""
              i = k + 1
              done = true
            }
            None => {}
          }
        }
        None => {}
      }
    }
    if not done {
      buf = buf + c
      i = i + 1
    }
  }
  return md_flush(out, buf)
}

fn md_is_wordy(c: str) -> bool {
  return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")
}

// ---- blocks

// A heading's anchor: lowercase letters, digits and dashes ("7. Built-in functions" -> "7-built-in-functions").
fn md_anchor(title: str) -> str {
  var out = ""
  var dash = false
  for c in chars(lower(title)) {
    if md_is_wordy(c) {
      if dash and out != "" {
        out = out + "-"
      }
      out = out + c
      dash = false
    } else if c == " " or c == "-" or c == "_" {
      dash = true
    }
  }
  return out
}

fn md_strip_heading(line: str) -> (int, str) {
  var level = 0
  let cs = chars(line)
  while level < len(cs) and cs[level] == "#" { level = level + 1 }
  return (level, trim(slice(line, level, len(line))))
}

fn md_is_heading(line: str) -> bool {
  return starts_with(line, "# ") or starts_with(line, "## ") or starts_with(line, "### ") or starts_with(line, "#### ")
}

fn md_heading_text(title: str) -> str {
  // headings are plain text for the table of contents: drop the backticks and stars
  return replace(replace(title, "`", ""), "**", "")
}

fn md_heading(line: str, links: list[MdLink]) -> Html[unit] {
  let (level, title) = md_strip_heading(line)
  let anchor = md_anchor(md_heading_text(title))
  let body = push(md_inline(title, links), a([class("anchor"), href("#" + anchor), md_aria_hidden()], [text("#")]))
  return match level {
    1 => h1([id(anchor)], body),
    2 => h2([id(anchor)], body),
    3 => h3([id(anchor)], body),
    _ => h4([id(anchor)], body),
  }
}

fn md_aria_hidden() -> Attr[unit] { return attr("aria-hidden", "true") }

fn md_is_bullet(line: str) -> bool { return starts_with(line, "* ") or starts_with(line, "- ") }

fn md_is_numbered(line: str) -> bool {
  let parts = split(line, ". ")
  return len(parts) > 1 and is_some(parse_int(parts[0])) and not contains(parts[0], " ")
}

fn md_same_list(line: str, numbered: bool) -> bool {
  return if numbered then md_is_numbered(line) else md_is_bullet(line)
}

fn md_item_text(line: str) -> str {
  return if md_is_bullet(line) then slice(line, 2, len(line)) else trim(slice(line, len(split(line, ". ")[0]) + 2, len(line)))
}

// Cells of a table row: split on | that is not escaped, then unescape \|.
fn md_cells(line: str) -> list[str] {
  var row = trim(line)
  if starts_with(row, "|") { row = slice(row, 1, len(row)) }
  if ends_with(row, "|") and not ends_with(row, "\\|") { row = slice(row, 0, len(row) - 1) }
  var cells: list[str] = []
  var cur = ""
  let cs = chars(row)
  var i = 0
  while i < len(cs) {
    if cs[i] == "\\" and i + 1 < len(cs) and cs[i + 1] == "|" {
      cur = cur + "|"
      i = i + 2
    } else if cs[i] == "|" {
      cells = push(cells, trim(cur))
      cur = ""
      i = i + 1
    } else {
      cur = cur + cs[i]
      i = i + 1
    }
  }
  return push(cells, trim(cur))
}

fn md_table(rows: list[str], links: list[MdLink]) -> Html[unit] {
  let head = md_cells(rows[0])
  let body = slice(rows, 2, len(rows))
  return div([class("table-wrap")], [table([], [
    thead([], [tr([], map(head, fn(c) => th([], md_inline(c, links))))]),
    tbody([], map(body, fn(r) => tr([], map(md_cells(r), fn(c) => td([], md_inline(c, links)))))),
  ])])
}

fn md_code_block(lang: str, body: str) -> Html[unit] {
  let content = if lang == "klar" then highlight_klar(body) else [text(body)]
  return pre([class("code"), attr("data-lang", lang)], [code([], content)])
}

// The page body for a Markdown document.
fn md_render(src: str, links: list[MdLink]) -> list[Html[unit]] {
  let lines = split(replace(src, "\r\n", "\n"), "\n")
  let n = len(lines)
  var out: list[Html[unit]] = []
  var para: list[str] = []
  var i = 0
  while i < n {
    let line = lines[i]
    let t = trim(line)
    let block = t == "" or starts_with(t, "```") or md_is_heading(t) or starts_with(t, "|") or md_is_bullet(t)
      or md_is_numbered(t) or starts_with(t, ">") or starts_with(t, "<!--")
    if block and len(para) > 0 {
      out = push(out, p([], md_inline(join(para, " "), links)))
      para = []
    }
    if t == "" {
      i = i + 1
    } else if starts_with(t, "<!--") {
      while i < n and not contains(lines[i], "-->") { i = i + 1 }
      i = i + 1
    } else if starts_with(t, "```") {
      let lang = trim(slice(t, 3, len(t)))
      var body: list[str] = []
      i = i + 1
      while i < n and not starts_with(trim(lines[i]), "```") {
        body = push(body, lines[i])
        i = i + 1
      }
      out = push(out, md_code_block(lang, join(body, "\n")))
      i = i + 1
    } else if md_is_heading(t) {
      out = push(out, md_heading(t, links))
      i = i + 1
    } else if starts_with(t, "|") {
      var rows: list[str] = []
      while i < n and starts_with(trim(lines[i]), "|") {
        rows = push(rows, lines[i])
        i = i + 1
      }
      out = push(out, md_table(rows, links))
    } else if starts_with(t, ">") {
      var quote: list[str] = []
      while i < n and starts_with(trim(lines[i]), ">") {
        quote = push(quote, trim(slice(trim(lines[i]), 1, len(trim(lines[i])))))
        i = i + 1
      }
      out = push(out, blockquote([], md_render(join(quote, "\n"), links)))
    } else if md_is_bullet(t) or md_is_numbered(t) {
      let numbered = md_is_numbered(t)
      var items: list[str] = []
      while i < n and trim(lines[i]) != "" and (md_same_list(trim(lines[i]), numbered) or starts_with(lines[i], "  ")) {
        let l = lines[i]
        if starts_with(l, "  ") and len(items) > 0 {
          items = set_at(items, len(items) - 1, items[len(items) - 1] + " " + trim(l))
        } else {
          items = push(items, md_item_text(trim(l)))
        }
        i = i + 1
      }
      let lis = map(items, fn(it) => li([], md_inline(it, links)))
      out = push(out, if numbered then ol([], lis) else ul([], lis))
    } else {
      para = push(para, t)
      i = i + 1
    }
  }
  if len(para) > 0 {
    out = push(out, p([], md_inline(join(para, " "), links)))
  }
  return out
}

// The ## and ### headings of a document, for its table of contents (code blocks are skipped).
fn md_headings(src: str) -> list[MdHeading] {
  var out: list[MdHeading] = []
  var in_code = false
  for line in split(src, "\n") {
    let t = trim(line)
    if starts_with(t, "```") {
      in_code = not in_code
    } else if not in_code and (starts_with(t, "## ") or starts_with(t, "### ")) {
      let (level, title) = md_strip_heading(t)
      let plain = md_heading_text(title)
      out = push(out, MdHeading(level: level, title: plain, anchor: md_anchor(plain)))
    }
  }
  return out
}

// The first # heading, or "" if there is none.
fn md_title(src: str) -> str {
  return match find(split(src, "\n"), fn(l) => starts_with(l, "# ")) {
    Some(l) => md_heading_text(trim(slice(l, 2, len(l)))),
    None => "",
  }
}
