enum Shape {
  Circle(radius: float),
  Rect(width: float, height: float),
}

fn area(s: Shape) -> float {
  return match s {
    Circle(r) => 3.14159 * r * r,
    Rect(w, h) => w * h,
  }
}

fn main() uses io {
  let shapes = [Circle(1.0), Rect(width: 2.0, height: 3.0)]
  for s in shapes {
    print("area: {area(s)}")
  }
}

test "rectangle area" {
  assert area(Rect(2.0, 3.0)) == 6.0
}
