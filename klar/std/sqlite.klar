// std.sqlite: embedded SQL database. Always pass values as parameters (`?`), never build SQL strings.
//
//   struct Card { id: int, title: str, column: Column, assignee: Option[int] }
//   let cards: list[Card] = sqlite_rows(db, "select id, title, col as column, assignee from cards where board = ?", [sql(id)])?
//   let total: Option[int] = sqlite_first(db, "select count(*) from cards", [])?

extern type Database

enum SqlValue {
  SqlNull,
  SqlInt(value: int),
  SqlFloat(value: float),
  SqlText(value: str),
}

// Use ":memory:" for a temporary database.
extern "klar.stdpy.sqlitelib.open_db" fn sqlite_open(path: str) -> Result[Database, str] uses io
// Run a statement; returns the number of affected rows.
extern "klar.stdpy.sqlitelib.execute" fn sqlite_exec(db: Database, sql: str, params: list[SqlValue]) -> Result[int, str] uses io
extern "klar.stdpy.sqlitelib.query" fn sqlite_query(db: Database, sql: str, params: list[SqlValue]) -> Result[list[map[str, SqlValue]], str] uses io
extern "klar.stdpy.sqlitelib.last_insert_id" fn sqlite_last_id(db: Database) -> int uses io
extern "klar.stdpy.sqlitelib.close" fn sqlite_close(db: Database) uses io

fn sql_text(v: SqlValue) -> Option[str] {
  return match v { SqlText(s) => Some(s), _ => None }
}

fn sql_int(v: SqlValue) -> Option[int] {
  return match v { SqlInt(n) => Some(n), _ => None }
}

fn sql_float(v: SqlValue) -> Option[float] {
  return match v { SqlFloat(x) => Some(x), SqlInt(n) => Some(to_float(n)), _ => None }
}

// Any value as a query parameter: int, float, str, bool (1 or 0), Option (None is NULL), an enum whose variants have
// no fields (its variant name); lists, maps, structs, tuples and other enums are stored as JSON text.
extern "klar:sql.value" fn sql[T](value: T) -> SqlValue

// Rows read as values of type T: a struct takes its fields from the columns of the same name (rename with `as`),
// a tuple takes the columns in order, any other type the only column. Columns convert back by the rules of `sql`.
extern "klar:sql.read" fn sql_read[T](rows: list[map[str, SqlValue]]) -> Result[list[T], str]

// Every row of a query as a T. The type comes from where the result goes: `let cards: list[Card] = sqlite_rows(...)?`
fn sqlite_rows[T](db: Database, query: str, params: list[SqlValue]) -> Result[list[T], str] uses io {
  return sql_read(sqlite_query(db, query, params)?)
}

// The first row as a T, or None when the query returns no rows.
fn sqlite_first[T](db: Database, query: str, params: list[SqlValue]) -> Result[Option[T], str] uses io {
  let rows: list[T] = sqlite_rows(db, query, params)?
  return Ok(get(rows, 0))
}

// Bring the tables up to date when the program starts: each step (one SQL statement) runs once, in order, in a
// transaction of its own, and the database remembers how many have run (`pragma user_version`). Only ever add
// steps at the end. Returns how many ran; refuses a database that has run more steps than the program knows.
//   sqlite_migrate(db, ["create table todos (id integer primary key, title text not null)",
//                       "alter table todos add column done integer not null default 0"])?
fn sqlite_migrate(db: Database, steps: list[str]) -> Result[int, str] uses io {
  let done: int = unwrap_or(sqlite_first(db, "pragma user_version", [])?, 0)
  if done > len(steps) {
    return Err("the database has run {done} migrations but this program knows {len(steps)}: is the program older than the database?")
  }
  for i in range(done, len(steps)) {
    let _ = sqlite_exec(db, "begin", [])?
    match sqlite_exec(db, steps[i], []) {
      Ok(_) => {}
      Err(e) => {
        let _ = sqlite_exec(db, "rollback", [])
        return Err("migration {i + 1}: {e}")
      }
    }
    let _ = sqlite_exec(db, "pragma user_version = {i + 1}", [])?
    let _ = sqlite_exec(db, "commit", [])?
  }
  return Ok(len(steps) - done)
}
