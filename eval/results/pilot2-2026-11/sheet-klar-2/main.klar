// Spreadsheet evaluator.

enum Tok {
  TInt(value: int),
  TCell(id: int),
  TFunc(name: str),
  TSym(s: str),
}

enum Expr {
  Lit(n: int),
  Ref(id: int),
  Range(fname: str, a: int, b: int),
  Neg(e: Expr),
  Bin(op: str, l: Expr, r: Expr),
}

enum Content {
  Number(n: int),
  Formula(e: Expr),
  Bad,
}

struct P { e: Expr, pos: int }

fn is_digit(c: str) -> bool {
  return c >= "0" and c <= "9"
}

fn is_upper(c: str) -> bool {
  return c >= "A" and c <= "Z"
}

fn col_index(c: str) -> int {
  return unwrap(index_of(chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ"), c))
}

fn digits_value(ds: list[str]) -> int {
  var n = 0
  for d in ds {
    n = n * 10 + unwrap(parse_int(d))
  }
  return n
}

// Parse a cell name like A1 / C12; returns id = col * 100 + row.
fn parse_cell_name(s: str) -> Option[int] {
  let cs = chars(s)
  if len(cs) < 2 or len(cs) > 3 { return None }
  if not is_upper(cs[0]) { return None }
  let ds = slice(cs, 1, len(cs))
  for d in ds {
    if not is_digit(d) { return None }
  }
  if ds[0] == "0" { return None }
  return Some(col_index(cs[0]) * 100 + digits_value(ds))
}

fn tokenize(src: str) -> Option[list[Tok]] {
  let cs = chars(src)
  var toks: list[Tok] = []
  var i = 0
  while i < len(cs) {
    let c = cs[i]
    if c == " " or c == "\t" {
      i = i + 1
    } else if is_digit(c) {
      var ds: list[str] = []
      while i < len(cs) and is_digit(cs[i]) {
        ds = push(ds, cs[i])
        i = i + 1
      }
      toks = push(toks, TInt(digits_value(ds)))
    } else if is_upper(c) {
      var ls = ""
      while i < len(cs) and is_upper(cs[i]) {
        ls = ls + cs[i]
        i = i + 1
      }
      if len(ls) == 1 and i < len(cs) and is_digit(cs[i]) {
        var name = ls
        while i < len(cs) and is_digit(cs[i]) {
          name = name + cs[i]
          i = i + 1
        }
        match parse_cell_name(name) {
          Some(id) => toks = push(toks, TCell(id)),
          None => return None,
        }
      } else if ls == "SUM" or ls == "MIN" or ls == "MAX" {
        toks = push(toks, TFunc(ls))
      } else {
        return None
      }
    } else if contains("+-*/():", c) {
      toks = push(toks, TSym(c))
      i = i + 1
    } else {
      return None
    }
  }
  return Some(toks)
}

fn is_sym(toks: list[Tok], pos: int, s: str) -> bool {
  return match get(toks, pos) {
    Some(TSym(x)) => x == s,
    _ => false,
  }
}

fn p_expr(toks: list[Tok], pos: int) -> Option[P] {
  var left = p_term(toks, pos)?
  while is_sym(toks, left.pos, "+") or is_sym(toks, left.pos, "-") {
    let op = if is_sym(toks, left.pos, "+") then "+" else "-"
    let right = p_term(toks, left.pos + 1)?
    left = P(e: Bin(op, left.e, right.e), pos: right.pos)
  }
  return Some(left)
}

fn p_term(toks: list[Tok], pos: int) -> Option[P] {
  var left = p_unary(toks, pos)?
  while is_sym(toks, left.pos, "*") or is_sym(toks, left.pos, "/") {
    let op = if is_sym(toks, left.pos, "*") then "*" else "/"
    let right = p_unary(toks, left.pos + 1)?
    left = P(e: Bin(op, left.e, right.e), pos: right.pos)
  }
  return Some(left)
}

fn p_unary(toks: list[Tok], pos: int) -> Option[P] {
  if is_sym(toks, pos, "-") {
    let inner = p_unary(toks, pos + 1)?
    return Some(P(e: Neg(inner.e), pos: inner.pos))
  }
  return p_primary(toks, pos)
}

fn p_primary(toks: list[Tok], pos: int) -> Option[P] {
  let t = get(toks, pos)?
  match t {
    TInt(n) => { return Some(P(e: Lit(n), pos: pos + 1)) }
    TCell(id) => { return Some(P(e: Ref(id), pos: pos + 1)) }
    TFunc(name) => {
      if not is_sym(toks, pos + 1, "(") { return None }
      let a = match get(toks, pos + 2) {
        Some(TCell(id)) => id,
        _ => -1,
      }
      if a < 0 { return None }
      if not is_sym(toks, pos + 3, ":") { return None }
      let b = match get(toks, pos + 4) {
        Some(TCell(id)) => id,
        _ => -1,
      }
      if b < 0 { return None }
      if not is_sym(toks, pos + 5, ")") { return None }
      return Some(P(e: Range(name, a, b), pos: pos + 6))
    }
    TSym(s) => {
      if s != "(" { return None }
      let inner = p_expr(toks, pos + 1)?
      if not is_sym(toks, inner.pos, ")") { return None }
      return Some(P(e: inner.e, pos: inner.pos + 1))
    }
  }
}

fn parse_formula(src: str) -> Option[Expr] {
  let toks = tokenize(src)?
  let p = p_expr(toks, 0)?
  if p.pos != len(toks) { return None }
  return Some(p.e)
}

fn parse_content(s: str) -> Content {
  if starts_with(s, "=") {
    return match parse_formula(slice(s, 1, len(s))) {
      Some(e) => Formula(e),
      None => Bad,
    }
  }
  let cs = chars(s)
  var start = 0
  var neg = false
  if len(cs) > 0 and cs[0] == "-" {
    start = 1
    neg = true
  }
  let ds = slice(cs, start, len(cs))
  if len(ds) == 0 { return Bad }
  for d in ds {
    if not is_digit(d) { return Bad }
  }
  let v = digits_value(ds)
  return Number(if neg then 0 - v else v)
}

// Adds node indices of defined cells referenced by e.
fn collect_refs(e: Expr, node_of: list[int], acc: list[int]) -> list[int] {
  match e {
    Lit(_) => { return acc }
    Ref(id) => {
      if node_of[id] >= 0 { return push(acc, node_of[id]) }
      return acc
    }
    Range(_, a, b) => {
      var out = acc
      let c1 = min(a / 100, b / 100)
      let c2 = max(a / 100, b / 100)
      let r1 = min(a % 100, b % 100)
      let r2 = max(a % 100, b % 100)
      var c = c1
      while c <= c2 {
        var r = r1
        while r <= r2 {
          let j = node_of[c * 100 + r]
          if j >= 0 { out = push(out, j) }
          r = r + 1
        }
        c = c + 1
      }
      return out
    }
    Neg(x) => { return collect_refs(x, node_of, acc) }
    Bin(_, l, r) => { return collect_refs(r, node_of, collect_refs(l, node_of, acc)) }
  }
}

// vi: values by cell id; ve: error text by cell id ("" when ok).
fn eval(e: Expr, vi: list[int], ve: list[str]) -> Result[int, str] {
  match e {
    Lit(n) => { return Ok(n) }
    Ref(id) => {
      if ve[id] != "" { return Err(ve[id]) }
      return Ok(vi[id])
    }
    Range(f, a, b) => {
      let c1 = min(a / 100, b / 100)
      let c2 = max(a / 100, b / 100)
      let r1 = min(a % 100, b % 100)
      let r2 = max(a % 100, b % 100)
      var acc = vi[c1 * 100 + r1]
      let mode = if f == "SUM" then 0 else if f == "MIN" then 1 else 2
      if mode == 0 { acc = 0 }
      var c = c1
      while c <= c2 {
        var r = r1
        while r <= r2 {
          let id = c * 100 + r
          if ve[id] != "" { return Err(ve[id]) }
          let v = vi[id]
          if mode == 0 {
            acc = acc + v
          } else if mode == 1 {
            if v < acc { acc = v }
          } else {
            if v > acc { acc = v }
          }
          r = r + 1
        }
        c = c + 1
      }
      return Ok(acc)
    }
    Neg(x) => {
      let v = eval(x, vi, ve)?
      return Ok(0 - v)
    }
    Bin(op, l, r) => {
      let lv = eval(l, vi, ve)?
      let rv = eval(r, vi, ve)?
      if op == "+" { return Ok(lv + rv) }
      if op == "-" { return Ok(lv - rv) }
      if op == "*" { return Ok(lv * rv) }
      if rv == 0 { return Err("#DIV0") }
      return Ok(lv / rv)
    }
  }
}

fn main() uses io {
  let letters = chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
  var defs: map[int, str] = [:]
  var line = read_line()
  while is_some(line) {
    let l = unwrap(line)
    if trim(l) != "" {
      let parts = split(l, ":")
      let name = trim(parts[0])
      let content = trim(join(slice(parts, 1, len(parts)), ":"))
      match parse_cell_name(name) {
        Some(id) => defs = put(defs, id, content),
        None => {}
      }
    }
    line = read_line()
  }

  // Nodes, in sorted order (col then row) -- id ordering gives that.
  let ids = sort(keys(defs))
  let n = len(ids)
  var contents: list[Content] = []
  for i in range(0, n) {
    contents = push(contents, parse_content(defs[ids[i]]))
  }
  // Only formula cells can take part in a cycle, so only they are edge targets.
  var node_of: list[int] = []
  for k in range(0, 2600) { node_of = push(node_of, -1) }
  for i in range(0, n) {
    match contents[i] {
      Formula(_) => node_of = set_at(node_of, ids[i], i),
      _ => {}
    }
  }
  var adj: list[list[int]] = []
  for i in range(0, n) {
    let c = contents[i]
    let nb: list[int] = match c {
      Formula(e) => collect_refs(e, node_of, []),
      _ => [],
    }
    adj = push(adj, nb)
  }

  // Iterative Tarjan SCC.
  var index: list[int] = []
  var low: list[int] = []
  var on_stack: list[bool] = []
  var in_cycle: list[bool] = []
  for i in range(0, n) {
    index = push(index, -1)
    low = push(low, 0)
    on_stack = push(on_stack, false)
    in_cycle = push(in_cycle, false)
  }
  var stack: list[int] = []
  var order: list[int] = []
  var counter = 0
  for s in range(0, n) {
    if index[s] >= 0 { continue }
    var cs_v: list[int] = [s]
    var cs_p: list[int] = [0]
    index = set_at(index, s, counter)
    low = set_at(low, s, counter)
    counter = counter + 1
    stack = push(stack, s)
    on_stack = set_at(on_stack, s, true)
    while len(cs_v) > 0 {
      let top = len(cs_v) - 1
      let v = cs_v[top]
      let p = cs_p[top]
      let nb = adj[v]
      if p < len(nb) {
        cs_p = set_at(cs_p, top, p + 1)
        let w = nb[p]
        if w == v {
          in_cycle = set_at(in_cycle, v, true)
        }
        if index[w] < 0 {
          index = set_at(index, w, counter)
          low = set_at(low, w, counter)
          counter = counter + 1
          stack = push(stack, w)
          on_stack = set_at(on_stack, w, true)
          cs_v = push(cs_v, w)
          cs_p = push(cs_p, 0)
        } else if on_stack[w] {
          if index[w] < low[v] { low = set_at(low, v, index[w]) }
        }
      } else {
        cs_v = slice(cs_v, 0, top)
        cs_p = slice(cs_p, 0, top)
        if top > 0 {
          let parent = cs_v[top - 1]
          if low[v] < low[parent] { low = set_at(low, parent, low[v]) }
        }
        if low[v] == index[v] {
          var comp: list[int] = []
          var done = false
          while not done {
            let w = stack[len(stack) - 1]
            stack = slice(stack, 0, len(stack) - 1)
            on_stack = set_at(on_stack, w, false)
            comp = push(comp, w)
            if w == v { done = true }
          }
          if len(comp) > 1 {
            for w in comp { in_cycle = set_at(in_cycle, w, true) }
          }
          order = order + comp
        }
      }
    }
  }

  var vi: list[int] = []
  var ve: list[str] = []
  for k in range(0, 2600) {
    vi = push(vi, 0)
    ve = push(ve, "")
  }
  // Plain cells first: formulas may read them in any order.
  for v in range(0, n) {
    match contents[v] {
      Number(k) => vi = set_at(vi, ids[v], k),
      Bad => ve = set_at(ve, ids[v], "#PARSE"),
      Formula(_) => {}
    }
  }
  for v in order {
    let res: Result[int, str] = if in_cycle[v] then Err("#CYCLE") else match contents[v] {
      Number(k) => Ok(k),
      Bad => Err("#PARSE"),
      Formula(e) => eval(e, vi, ve),
    }
    match res {
      Ok(k) => vi = set_at(vi, ids[v], k),
      Err(m) => ve = set_at(ve, ids[v], m),
    }
  }

  for i in range(0, n) {
    let id = ids[i]
    let text = if ve[id] != "" then ve[id] else str(vi[id])
    print("{letters[id / 100]}{id % 100} = {text}")
  }
}
