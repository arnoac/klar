// A small spreadsheet evaluator. Reads "CELL: CONTENT" lines from stdin and prints every defined cell.

enum Tok {
  TNum(value: int),
  TCell(key: str),
  TFunc(name: str),
  TSym(sym: str),
}

enum Expr {
  ENum(value: int),
  ERef(key: str),
  ECall(func: str, first: str, last_key: str),
  ENeg(inner: Expr),
  EBin(op: str, left: Expr, right: Expr),
}

fn is_digit(c: str) -> bool {
  return c >= "0" and c <= "9"
}

fn is_upper(c: str) -> bool {
  return c >= "A" and c <= "Z"
}

// ---------- tokenizer ----------

fn tokenize(cs: list[str]) -> Result[list[Tok], str] {
  var toks: list[Tok] = []
  var i = 0
  let n = len(cs)
  while i < n {
    let c = cs[i]
    if c == " " or c == "\t" {
      i = i + 1
    } else if is_digit(c) {
      var j = i
      while j < n and is_digit(cs[j]) {
        j = j + 1
      }
      toks = push(toks, TNum(unwrap(parse_int(join(slice(cs, i, j), "")))))
      i = j
    } else if is_upper(c) {
      var j = i
      while j < n and is_upper(cs[j]) {
        j = j + 1
      }
      let word = join(slice(cs, i, j), "")
      if j - i == 1 and j < n and is_digit(cs[j]) {
        var k = j
        while k < n and is_digit(cs[k]) {
          k = k + 1
        }
        let digits = join(slice(cs, j, k), "")
        if starts_with(digits, "0") or len(digits) > 2 {
          return Err("#PARSE")
        }
        toks = push(toks, TCell(word + digits))
        i = k
      } else if word == "SUM" or word == "MIN" or word == "MAX" {
        toks = push(toks, TFunc(word))
        i = j
      } else {
        return Err("#PARSE")
      }
    } else if contains("+-*/():", c) {
      toks = push(toks, TSym(c))
      i = i + 1
    } else {
      return Err("#PARSE")
    }
  }
  return Ok(toks)
}

// ---------- parser: every function returns the parsed value and the next token position ----------

fn sym_at(ts: list[Tok], p: int, s: str) -> bool {
  if p >= len(ts) {
    return false
  }
  return match ts[p] {
    TSym(x) => x == s,
    _ => false,
  }
}

fn cell_at(ts: list[Tok], p: int) -> Result[str, str] {
  if p >= len(ts) {
    return Err("#PARSE")
  }
  return match ts[p] {
    TCell(k) => Ok(k),
    _ => Err("#PARSE"),
  }
}

fn parse_primary(ts: list[Tok], p: int) -> Result[(Expr, int), str] {
  if p >= len(ts) {
    return Err("#PARSE")
  }
  return match ts[p] {
    TNum(v) => Ok((ENum(v), p + 1)),
    TCell(k) => Ok((ERef(k), p + 1)),
    TFunc(name) => {
      if not sym_at(ts, p + 1, "(") {
        return Err("#PARSE")
      }
      let a = cell_at(ts, p + 2)?
      if not sym_at(ts, p + 3, ":") {
        return Err("#PARSE")
      }
      let b = cell_at(ts, p + 4)?
      if not sym_at(ts, p + 5, ")") {
        return Err("#PARSE")
      }
      return Ok((ECall(name, a, b), p + 6))
    }
    TSym(s) => {
      if s == "(" {
        let (e, q) = parse_expr(ts, p + 1)?
        if not sym_at(ts, q, ")") {
          return Err("#PARSE")
        }
        return Ok((e, q + 1))
      }
      return Err("#PARSE")
    }
  }
}

fn parse_unary(ts: list[Tok], p: int) -> Result[(Expr, int), str] {
  if sym_at(ts, p, "-") {
    let (e, q) = parse_unary(ts, p + 1)?
    return Ok((ENeg(e), q))
  }
  return parse_primary(ts, p)
}

fn parse_term(ts: list[Tok], p: int) -> Result[(Expr, int), str] {
  let (first, p1) = parse_unary(ts, p)?
  var left = first
  var pos = p1
  while sym_at(ts, pos, "*") or sym_at(ts, pos, "/") {
    let op = if sym_at(ts, pos, "*") then "*" else "/"
    let (right, q) = parse_unary(ts, pos + 1)?
    left = EBin(op, left, right)
    pos = q
  }
  return Ok((left, pos))
}

fn parse_expr(ts: list[Tok], p: int) -> Result[(Expr, int), str] {
  let (first, p1) = parse_term(ts, p)?
  var left = first
  var pos = p1
  while sym_at(ts, pos, "+") or sym_at(ts, pos, "-") {
    let op = if sym_at(ts, pos, "+") then "+" else "-"
    let (right, q) = parse_term(ts, pos + 1)?
    left = EBin(op, left, right)
    pos = q
  }
  return Ok((left, pos))
}

fn parse_formula(s: str) -> Result[Expr, str] {
  let ts = tokenize(chars(s))?
  let (e, p) = parse_expr(ts, 0)?
  if p != len(ts) {
    return Err("#PARSE")
  }
  return Ok(e)
}

// Content that does not start with "=": an optional '-' and one or more digits.
fn parse_literal(s: str) -> Result[Expr, str] {
  let body = if starts_with(s, "-") then slice(s, 1, len(s)) else s
  if len(body) == 0 {
    return Err("#PARSE")
  }
  for c in chars(body) {
    if not is_digit(c) {
      return Err("#PARSE")
    }
  }
  return Ok(ENum(unwrap(parse_int(s))))
}

fn parse_content(s: str) -> Result[Expr, str] {
  if starts_with(s, "=") {
    return parse_formula(slice(s, 1, len(s)))
  }
  return parse_literal(s)
}

// ---------- cell names ----------

fn col_num(k: str) -> int {
  return ord(k[0]) - 65
}

fn row_num(k: str) -> int {
  return unwrap(parse_int(slice(k, 1, len(k))))
}

fn make_key(c: int, r: int) -> str {
  return chr(c + 65) + str(r)
}

// Cell index used for output order: column first, then row.
fn cell_index(k: str) -> int {
  return col_num(k) * 100 + row_num(k)
}

// All cells of the rectangle with corners a and b, column by column, top to bottom.
fn range_keys(a: str, b: str) -> list[str] {
  let ca = col_num(a)
  let cb = col_num(b)
  let ra = row_num(a)
  let rb = row_num(b)
  var out: list[str] = []
  for c in range(min(ca, cb), max(ca, cb) + 1) {
    for r in range(min(ra, rb), max(ra, rb) + 1) {
      out = push(out, make_key(c, r))
    }
  }
  return out
}

// ---------- references (dependencies) ----------

fn expr_deps(e: Expr) -> list[str] {
  return match e {
    ENum(_) => [],
    ERef(k) => [k],
    ECall(_, a, b) => range_keys(a, b),
    ENeg(x) => expr_deps(x),
    EBin(_, l, r) => expr_deps(l) + expr_deps(r),
  }
}

fn form_deps(form: Result[Expr, str]) -> list[str] {
  return match form {
    Ok(e) => expr_deps(e),
    Err(_) => [],
  }
}

// True when following references from `start` leads back to `start`.
fn reaches_self(start: str, deps_of: map[str, list[str]]) -> bool {
  var stack: list[str] = deps_of[start]
  var seen: map[str, bool] = [:]
  while len(stack) > 0 {
    let k = unwrap(last(stack))
    stack = pop(stack)
    if k == start {
      return true
    }
    if not has(seen, k) and has(deps_of, k) {
      seen = put(seen, k, true)
      stack = stack + deps_of[k]
    }
  }
  return false
}

// ---------- evaluation ----------

fn apply_op(op: str, a: int, b: int) -> Result[int, str] {
  if op == "+" {
    return Ok(a + b)
  }
  if op == "-" {
    return Ok(a - b)
  }
  if op == "*" {
    return Ok(a * b)
  }
  if b == 0 {
    return Err("#DIV0")
  }
  return Ok(a / b)
}

// Undefined cells are empty and count as 0.
fn cell_value(k: str, memo: map[str, Result[int, str]]) -> Result[int, str] {
  if has(memo, k) {
    return memo[k]
  }
  return Ok(0)
}

fn eval_call(f: str, ks: list[str], memo: map[str, Result[int, str]]) -> Result[int, str] {
  var acc = 0
  var first = true
  for k in ks {
    let v = cell_value(k, memo)?
    if first {
      acc = v
      first = false
    } else if f == "SUM" {
      acc = acc + v
    } else if f == "MIN" {
      acc = min(acc, v)
    } else {
      acc = max(acc, v)
    }
  }
  return Ok(acc)
}

fn eval_expr(e: Expr, memo: map[str, Result[int, str]]) -> Result[int, str] {
  return match e {
    ENum(v) => Ok(v),
    ERef(k) => cell_value(k, memo),
    ECall(f, a, b) => eval_call(f, range_keys(a, b), memo),
    ENeg(x) => {
      let v = eval_expr(x, memo)?
      return Ok(0 - v)
    }
    EBin(op, l, r) => {
      let a = eval_expr(l, memo)?
      let b = eval_expr(r, memo)?
      return apply_op(op, a, b)
    }
  }
}

fn cell_result(form: Result[Expr, str], memo: map[str, Result[int, str]]) -> Result[int, str] {
  return match form {
    Ok(e) => eval_expr(e, memo),
    Err(msg) => Err(msg),
  }
}

// Evaluates a cell after its references, so every operand already has a value in memo.
// Cells on a cycle are preset to #CYCLE, so this recursion only follows acyclic references.
fn visit(key: str, forms: map[str, Result[Expr, str]], deps_of: map[str, list[str]], memo: map[str, Result[int, str]]) -> map[str, Result[int, str]] {
  if has(memo, key) {
    return memo
  }
  var m = memo
  for d in deps_of[key] {
    if has(forms, d) {
      m = visit(d, forms, deps_of, m)
    }
  }
  let v = cell_result(forms[key], m)
  return put(m, key, v)
}

fn show_result(r: Result[int, str]) -> str {
  return match r {
    Ok(v) => str(v),
    Err(msg) => msg,
  }
}

fn main() uses io {
  let text = read_all()
  var forms: map[str, Result[Expr, str]] = [:]
  for line in split(text, "\n") {
    let t = trim(line)
    if len(t) > 0 {
      let parts = split(t, ":")
      let name = trim(parts[0])
      let content = trim(join(slice(parts, 1, len(parts)), ":"))
      forms = put(forms, name, parse_content(content))
    }
  }

  let all = keys(forms)
  var deps_of: map[str, list[str]] = [:]
  for k in all {
    deps_of = put(deps_of, k, form_deps(forms[k]))
  }

  var memo: map[str, Result[int, str]] = [:]
  let cyc: Result[int, str] = Err("#CYCLE")
  for k in all {
    if reaches_self(k, deps_of) {
      memo = put(memo, k, cyc)
    }
  }
  for k in all {
    memo = visit(k, forms, deps_of, memo)
  }

  for k in sort_by(all, fn(x: str) => cell_index(x)) {
    print("{k} = {show_result(memo[k])}")
  }
}
