// Klar Board report: sign in to a running board server and summarise every board, fetching them all at once.
//
//   echo "$PASSWORD" | klar run examples/apps/board/report.klar http://127.0.0.1:8080 ada
//
// Shows std.task (task_all runs the requests concurrently, results stay in order) and the HTTP client.

use std.http { HttpResponse, http_request }
use std.json { json_encode }
use std.api { api_fetch, api_path, api_error_text }
use std.task { task_all }
use shared { Board, Credentials, summary, log_in_call, boards_call, board_call }

// The session cookie from a login reply's set-cookie header.
fn session_from(res: HttpResponse) -> Option[str] {
  let header = unwrap_or(get(res.headers, "set-cookie"), "")
  let first = split(header, ";")[0]
  return if contains(first, "=") then Some(first) else None
}

fn board_line(base: str, cookie: str, b: Board) -> str uses io {
  return match api_fetch(base, board_call(), b.id, ["cookie": cookie]) {
    Ok(page) => "{b.name}: {summary(page.cards)}",
    Err(e) => "{b.name}: {api_error_text(e)}",
  }
}

fn report(base: str, name: str, password: str) -> Result[unit, str] uses io {
  // Signing in is the one call made by hand: the session comes back as a cookie, not in the reply.
  let login = http_request("POST", base + api_path(log_in_call()), ["content-type": "application/json"],
    json_encode(Credentials(name: name, password: password)))?
  if login.status != 200 {
    return Err("could not sign in as {name} ({login.status})")
  }
  let cookie = session_from(login).ok_or("the server sent no session")?
  let boards = match api_fetch(base, boards_call(), (), ["cookie": cookie]) { Ok(bs) => bs, Err(e) => { return Err(api_error_text(e)) } }
  var jobs: list[fn() -> str uses io] = []
  for b in boards {
    jobs = push(jobs, fn() => board_line(base, cookie, b))
  }
  print("{len(boards)} boards for {name}")
  for line in task_all(jobs) {
    print(line)
  }
  return Ok(())
}

fn main() uses io {
  let a = args()
  if len(a) != 2 {
    print("usage: report.klar BASE_URL NAME   (the password is read from stdin)")
    return
  }
  match report(a[0], a[1], trim(unwrap_or(read_line(), ""))) {
    Ok(_) => {}
    Err(e) => print("error: {e}"),
  }
}
