// Klar Board: accounts and sessions.
//
// Passwords are stored as salted PBKDF2 hashes (std.crypto). A session is a random token in an HttpOnly cookie;
// the database keeps only the token's SHA-256, so a leaked database does not leak working sessions.

use std.sqlite { Database }
use std.http { HttpRequest, HttpResponse }
use std.web { web_cookies, web_set_cookie, web_clear_cookie }
use std.api { ApiError, Refused, or_refuse }
use std.crypto { crypto_sha256, crypto_token, crypto_password_hash, crypto_password_verify }
use shared { User, Credentials, check_user_name, check_password }
use store { user_add, user_by_name, session_add, session_user, session_delete }

fn session_cookie() -> str {
  return "board_session"
}

// Start a session: the reply is the user, and the response sets the cookie.
fn start_session(db: Database, user: User) -> Result[(User, fn(HttpResponse) -> HttpResponse), ApiError] uses io {
  let token = crypto_token(32)
  session_add(db, crypto_sha256(token), user.id)?
  return Ok((user, fn(res) => web_set_cookie(res, session_cookie(), token)))
}

fn sign_up(db: Database, c: Credentials) -> Result[(User, fn(HttpResponse) -> HttpResponse), ApiError] uses io {
  let name = check_user_name(c.name).or_refuse(400)?
  let _ = check_password(c.password).or_refuse(400)?
  if is_some(user_by_name(db, name)?) {
    return Err(Refused(409, "that name is taken"))
  }
  return start_session(db, user_add(db, name, crypto_password_hash(c.password))?)
}

fn log_in(db: Database, c: Credentials) -> Result[(User, fn(HttpResponse) -> HttpResponse), ApiError] uses io {
  let wrong = Refused(401, "wrong name or password")
  let (user, hash) = user_by_name(db, lower(trim(c.name)))?.ok_or(wrong)?
  if not crypto_password_verify(c.password, hash) {
    return Err(wrong)
  }
  return start_session(db, user)
}

fn log_out(db: Database, req: HttpRequest) -> Result[(unit, fn(HttpResponse) -> HttpResponse), ApiError] uses io {
  match session_token(req) {
    Some(token) => session_delete(db, crypto_sha256(token))?,
    None => {}
  }
  return Ok(((), fn(res) => web_clear_cookie(res, session_cookie())))
}

fn session_token(req: HttpRequest) -> Option[str] {
  return get(web_cookies(req), session_cookie())
}

// The signed-in user, or 401.
fn signed_in(db: Database, req: HttpRequest) -> Result[User, ApiError] uses io {
  let token = session_token(req).ok_or(Refused(401, "not signed in"))?
  return session_user(db, crypto_sha256(token))?.ok_or(Refused(401, "not signed in"))
}
