// Klar Board, backend: the typed calls declared in shared.klar, on SQLite, with accounts, shared boards and live
// updates. It also serves the browser app (app.html, built from app.klar).
//
//   klar dev examples/apps/board/server.klar examples/apps/board/app.klar        then open http://127.0.0.1:8000
//
// Boards you are not a member of answer 404, the same as boards that do not exist.

use std.http { HttpRequest, HttpResponse }
use std.web { Route, web_get, web_serve, web_port, web_file, web_events, web_publish }
use std.api { ApiError, Refused, or_refuse, api_serve, api_serve_response, api_error_response }
use std.json { json_encode }
use std.sqlite { Database }
use std.process { env_get }
use shared { User, Board, Card, BoardPage, Credentials, Invite, NewCard, CardEdit, CardMove, check_title, column_title,
  sign_up_call, log_in_call, log_out_call, me_call, boards_call, create_board_call, board_call, invite_call,
  add_card_call, edit_card_call, move_card_call, delete_card_call }
use store { store_open, boards_of, board_find, board_add, member_add, is_member, card_find, card_add, card_edit,
  card_move, card_delete, event_add, board_page, user_by_name }
use auth { sign_up, log_in, log_out, signed_in }

// In these handlers `?` on a database call (Result[_, str]) answers 500 and logs the error; a Refused answers
// with its status and message.

fn not_found() -> ApiError {
  return Refused(404, "not found")
}

// ---- boards

// Every board call starts with the signed-in user and the board, or answers 401 / 404.
struct Access { user: User, board: Board }

fn board_access(db: Database, req: HttpRequest, board_id: int) -> Result[Access, ApiError] uses io {
  let user = signed_in(db, req)?
  let board = board_find(db, board_id)?.ok_or(not_found())?
  if not is_member(db, board.id, user.id)? {
    return Err(not_found())
  }
  return Ok(Access(user, board))
}

// A card and access to its board.
fn card_access(db: Database, req: HttpRequest, card_id: int) -> Result[(Access, Card), ApiError] uses io {
  let card = card_find(db, card_id)?.ok_or(not_found())?
  return Ok((board_access(db, req, card.board_id)?, card))
}

// After a change: record it in the activity feed and send the new page to everyone watching the board.
fn changed(db: Database, a: Access, what: str) -> Result[BoardPage, ApiError] uses io {
  event_add(db, a.board.id, a.user, what)?
  let page = board_page(db, a.board)?
  web_publish("board:{a.board.id}", json_encode(page))
  return Ok(page)
}

fn my_boards(db: Database, req: HttpRequest) -> Result[list[Board], ApiError] uses io {
  return Ok(boards_of(db, signed_in(db, req)?.id)?)
}

fn create_board(db: Database, req: HttpRequest, name: str) -> Result[Board, ApiError] uses io {
  let user = signed_in(db, req)?
  let board = board_add(db, check_title(name).or_refuse(400)?, user)?
  event_add(db, board.id, user, "created the board")?
  return Ok(board)
}

fn show_board(db: Database, req: HttpRequest, board_id: int) -> Result[BoardPage, ApiError] uses io {
  return Ok(board_page(db, board_access(db, req, board_id)?.board)?)
}

// GET /api/boards/:id/live: a BoardPage after every change (server-sent events), for members only.
fn live_board(db: Database, req: HttpRequest) -> HttpResponse uses io {
  let board_id = unwrap_or(parse_int(unwrap_or(get(req.params, "id"), "")), 0)
  return match board_access(db, req, board_id) {
    Ok(a) => web_events("board:{a.board.id}"),
    Err(e) => api_error_response(e),
  }
}

fn invite(db: Database, req: HttpRequest, inv: Invite) -> Result[BoardPage, ApiError] uses io {
  let a = board_access(db, req, inv.board_id)?
  let name = lower(trim(inv.name))
  let (user, _) = user_by_name(db, name)?.ok_or(Refused(404, "nobody is called {name}"))?
  member_add(db, a.board.id, user.id)?
  return changed(db, a, "added {name} to the board")
}

// ---- cards

fn add_card(db: Database, req: HttpRequest, new: NewCard) -> Result[Card, ApiError] uses io {
  let a = board_access(db, req, new.board_id)?
  let title = check_title(new.title).or_refuse(400)?
  let card = card_add(db, a.board.id, title, new.column)?
  let _ = changed(db, a, "added “{title}” to {column_title(new.column)}")?
  return Ok(card)
}

fn edit_card(db: Database, req: HttpRequest, edit: CardEdit) -> Result[Card, ApiError] uses io {
  let (a, card) = card_access(db, req, edit.card_id)?
  let title = check_title(edit.title).or_refuse(400)?
  match edit.assignee {
    Some(uid) => {
      if not is_member(db, card.board_id, uid)? {
        return Err(Refused(400, "only board members can be assigned"))
      }
    }
    None => {}
  }
  let saved = card with (title: title, notes: trim(edit.notes), assignee: edit.assignee)
  card_edit(db, saved)?
  let _ = changed(db, a, "edited “{title}”")?
  return Ok(saved)
}

fn move_card_to(db: Database, req: HttpRequest, mv: CardMove) -> Result[BoardPage, ApiError] uses io {
  let (a, card) = card_access(db, req, mv.card_id)?
  card_move(db, card, mv.column, mv.position)?
  let what = if mv.column == card.column then "reordered “{card.title}”" else "moved “{card.title}” to {column_title(mv.column)}"
  return changed(db, a, what)
}

fn delete_card(db: Database, req: HttpRequest, card_id: int) -> Result[BoardPage, ApiError] uses io {
  let (a, card) = card_access(db, req, card_id)?
  card_delete(db, card)?
  return changed(db, a, "deleted “{card.title}”")
}

// ---- wiring

fn routes(db: Database, dir: str) -> list[Route] {
  let app = fn(req: HttpRequest) => web_file(dir + "/app.html")
  return [
    web_get("/", app),
    web_get("/login", app),
    web_get("/boards/:id", app),
    web_get("/api/boards/:id/live", fn(req) => live_board(db, req)),
    api_serve_response(sign_up_call(), fn(req, c) => sign_up(db, c)),
    api_serve_response(log_in_call(), fn(req, c) => log_in(db, c)),
    api_serve_response(log_out_call(), fn(req, nothing) => log_out(db, req)),
    api_serve(me_call(), fn(req, nothing) => signed_in(db, req)),
    api_serve(boards_call(), fn(req, nothing) => my_boards(db, req)),
    api_serve(create_board_call(), fn(req, name) => create_board(db, req, name)),
    api_serve(board_call(), fn(req, id) => show_board(db, req, id)),
    api_serve(invite_call(), fn(req, inv) => invite(db, req, inv)),
    api_serve(add_card_call(), fn(req, new) => add_card(db, req, new)),
    api_serve(edit_card_call(), fn(req, edit) => edit_card(db, req, edit)),
    api_serve(move_card_call(), fn(req, mv) => move_card_to(db, req, mv)),
    api_serve(delete_card_call(), fn(req, id) => delete_card(db, req, id)),
  ]
}

fn main() uses io {
  let port = web_port(8080)
  let db_path = unwrap_or(env_get("BOARD_DB"), "board.db")
  let dir = unwrap_or(env_get("APP_DIR"), ".")
  match store_open(db_path) {
    Err(e) => print("cannot open {db_path}: {e}"),
    Ok(db) => {
      print("Klar Board on http://127.0.0.1:{port}")
      match web_serve(port, routes(db, dir)) {
        Ok(_) => {}
        Err(e) => print("server error: {e}"),
      }
    }
  }
}
