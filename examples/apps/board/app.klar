// Klar Board, frontend: runs in the browser and talks to server.klar.
//
//   klar dev examples/apps/board/server.klar examples/apps/board/app.klar
//   klar test examples/apps/board/app.klar
//
// Pages: /login, / (your boards) and /boards/:id (one board, live). Moves are shown at once using the same
// rule the server applies (shared.move_card), then the server's reply or live update confirms them.

use std.ui { Next, ui_start, ui_get, ui_send, ui_go, ui_focus, ui_listen, ui_unlisten }
use std.html { Html, h1, h2, h3, p, a, span, ul, li, form, input, textarea, button, small, header, text,
  nothing, class, id, href, attr, placeholder, value, input_type, disabled, on_input, on_submit, on_click, on_drag, on_drag_end, on_drop, html_render,
  html_theme_css }
use std.layout { Zero, Xs, Sm, Tablet, Narrow, Readable, Wide, Rem, container, row, stack, grid, spread, center, box, gap,
  pad, pad_x, cols, cols_at, fit_cols, max_width, centered, grow, no_wrap }
use std.kit { Outline, Ghost, Destructive, Link, Small, Neutral, Danger, Choice, variant, size, icon_button, field,
  select_box, badge, alert_dismissable, spinner, empty_state, dialog, panel, avatar, kit_theme, default_theme }
use std.http { HttpResponse }
use std.json { JNull, json_of, json_decode }
use shared { Column, Todo, Doing, Done, User, Board, Card, Event, BoardPage, Credentials, NewBoard, NewCard, CardEdit,
  CardMove, Invite, ApiError, columns, column_title, column_left, column_right, cards_in, move_card, search,
  member_name, summary, check_title, check_user_name, check_password }

enum Page { Loading, LoginPage, BoardsPage, BoardView(board_id: int), Missing }

// The card being edited, as the form's current text.
struct CardForm { card_id: int, title: str, notes: str, assignee: str }

struct Model {
  page: Page,
  me: Option[User],
  name: str,                   // login form
  password: str,
  signing_up: bool,
  boards: list[Board],
  new_board: str,
  board: Option[BoardPage],
  drafts: map[str, str],       // new card title per column
  query: str,
  editing: Option[CardForm],
  dragging: Option[int],       // the card being dragged
  invite: str,
  status: str,                 // the last error, shown at the top; "" when all is well
  live: str,                   // the stream we listen to, "" for none
}

enum Msg {
  UrlChanged(path: str),
  GotMe(reply: Result[HttpResponse, str]),
  NameTyped(text: str),
  PasswordTyped(text: str),
  ToggleSignUp,
  SubmitLogin,
  LoggedIn(reply: Result[HttpResponse, str]),
  LogOut,
  LoggedOut(reply: Result[HttpResponse, str]),
  GotBoards(reply: Result[HttpResponse, str]),
  BoardNameTyped(text: str),
  CreateBoard,
  BoardCreated(reply: Result[HttpResponse, str]),
  GotBoard(reply: Result[HttpResponse, str]),
  Live(data: str),
  DraftTyped(column: Column, text: str),
  AddCard(column: Column),
  CardAdded(reply: Result[HttpResponse, str]),
  Move(card_id: int, column: Column, position: int),
  DragCard(card_id: int),
  DragEnded,
  DropAt(column: Column, position: int),   // position 1000 = the end
  Edit(card: Card),
  EditTitle(text: str),
  EditNotes(text: str),
  EditAssignee(text: str),
  SaveEdit,
  CancelEdit,
  Delete(card_id: int),
  QueryTyped(text: str),
  InviteTyped(text: str),
  SendInvite,
  PageReply(reply: Result[HttpResponse, str]),     // replies that carry the whole board
  Saved(reply: Result[HttpResponse, str]),         // replies we only check for errors
  DismissStatus,
}

fn empty_model() -> Model {
  return Model(page: Loading, me: None, name: "", password: "", signing_up: false, boards: [], new_board: "",
    board: None, drafts: [:], query: "", editing: None, invite: "", status: "", live: "", dragging: None)
}

fn init() -> Next[Model, Msg] {
  return Next(empty_model(), [ui_get("/api/me", fn(r) => GotMe(r))])
}

// ---- routing

fn page_of(path: str) -> Page {
  let parts = filter(split(path, "/"), fn(s) => s != "")
  if len(parts) == 0 {
    return BoardsPage
  }
  if parts == ["login"] {
    return LoginPage
  }
  if len(parts) == 2 and parts[0] == "boards" {
    return match parse_int(parts[1]) { Some(n) => BoardView(n), None => Missing }
  }
  return Missing
}

fn live_url(page: Page) -> str {
  return match page { BoardView(n) => "/api/boards/{n}/live", _ => "" }
}

// Show a page: load what it needs, and listen to the right board (and only that one).
fn open_page(m: Model, page: Page) -> Next[Model, Msg] {
  let url = live_url(page)
  var cmds = if m.live != "" and m.live != url then [ui_unlisten(m.live)] else []
  cmds = cmds + match page {
    BoardsPage => [ui_get("/api/boards", fn(r) => GotBoards(r))],
    BoardView(n) => [ui_get("/api/boards/{n}", fn(r) => GotBoard(r))] + (if url != m.live then [ui_listen(url, fn(d) => Live(d))] else []),
    LoginPage => [ui_focus("name")],
    _ => [],
  }
  let board = match page { BoardView(n) => m.board, _ => None }
  return Next(m with (page: page, live: url, board: board, editing: None, query: "", status: ""), cmds)
}

// ---- update

fn update(m: Model, msg: Msg) -> Next[Model, Msg] {
  return match msg {
    UrlChanged(path) => if is_none(m.me) and m.page == Loading then Next(m with (page: page_of(path)), [])
      else open_page(m, page_of(path)),
    GotMe(reply) => match read_user(reply) {
      Ok(u) => open_page(m with (me: Some(u)), if m.page == LoginPage or m.page == Loading then BoardsPage else m.page),
      Err(_) => Next(m with (page: LoginPage), [ui_go("/login")]),
    },
    NameTyped(t) => Next(m with (name: t), []),
    PasswordTyped(t) => Next(m with (password: t), []),
    ToggleSignUp => Next(m with (signing_up: not m.signing_up, status: ""), []),
    SubmitLogin => match login_problem(m) {
      Some(problem) => Next(m with (status: problem), []),
      None => Next(m with (status: ""), [
        ui_send("POST", if m.signing_up then "/api/signup" else "/api/login",
          json_of(Credentials(name: m.name, password: m.password)), fn(r) => LoggedIn(r)),
      ]),
    },
    LoggedIn(reply) => match read_user(reply) {
      Ok(u) => Next(m with (me: Some(u), password: "", status: ""), [ui_go("/")]),
      Err(e) => Next(m with (status: e), []),
    },
    LogOut => Next(m, [ui_send("POST", "/api/logout", JNull, fn(r) => LoggedOut(r))]),
    LoggedOut(_) => Next(empty_model() with (page: LoginPage), (if m.live != "" then [ui_unlisten(m.live)] else []) + [ui_go("/login")]),
    GotBoards(reply) => match read_boards(reply) {
      Ok(bs) => Next(m with (boards: bs), []),
      Err(e) => failed(m, e),
    },
    BoardNameTyped(t) => Next(m with (new_board: t), []),
    CreateBoard => match check_title(m.new_board) {
      Err(e) => Next(m with (status: e), []),
      Ok(n) => Next(m with (new_board: ""), [ui_send("POST", "/api/boards", json_of(NewBoard(name: n)), fn(r) => BoardCreated(r))]),
    },
    BoardCreated(reply) => match read_board(reply) {
      Ok(b) => Next(m with (boards: push(m.boards, b)), [ui_go("/boards/{b.id}")]),
      Err(e) => failed(m, e),
    },
    GotBoard(reply) => match read_page(reply) {
      Ok(page) => Next(m with (board: Some(page)), []),
      Err(e) => if contains(e, "404") then Next(m with (page: Missing, board: None), []) else failed(m, e),
    },
    Live(data) => match json_decode(data) {
      Ok(page) => Next(m with (board: Some(page)), []),
      Err(_) => Next(m, []),
    },
    DraftTyped(c, t) => Next(m with (drafts: put(m.drafts, column_title(c), t)), []),
    AddCard(c) => match check_title(unwrap_or(get(m.drafts, column_title(c)), "")) {
      Err(e) => Next(m with (status: e), []),
      Ok(title) => Next(m with (drafts: put(m.drafts, column_title(c), ""), status: ""), [
        ui_send("POST", "/api/boards/{board_id(m)}/cards", json_of(NewCard(title: title, column: c)), fn(r) => CardAdded(r)),
      ]),
    },
    CardAdded(reply) => match read_card(reply) {
      Ok(c) => Next(with_cards(m, fn(cards) => if any(cards, fn(x) => x.id == c.id) then cards else push(cards, c)), []),
      Err(e) => failed(m, e),
    },
    DragCard(card_id) => Next(m with (dragging: Some(card_id)), []),
    DragEnded => Next(m with (dragging: None), []),
    DropAt(c, position) => match m.dragging {
      Some(card_id) => update(m with (dragging: None), Move(card_id, c, position)),
      None => Next(m, []),
    },
    Move(card_id, c, position) => Next(with_cards(m, fn(cards) => move_card(cards, card_id, c, position)), [
      ui_send("PUT", "/api/cards/{card_id}/move", json_of(CardMove(column: c, position: position)), fn(r) => PageReply(r)),
    ]),
    Edit(c) => Next(m with (editing: Some(CardForm(c.id, c.title, c.notes, match c.assignee { Some(n) => str(n), None => "" }))), [
      ui_focus("edit-title"),
    ]),
    EditTitle(t) => Next(with_form(m, fn(f) => f with (title: t)), []),
    EditNotes(t) => Next(with_form(m, fn(f) => f with (notes: t)), []),
    EditAssignee(t) => Next(with_form(m, fn(f) => f with (assignee: t)), []),
    CancelEdit => Next(m with (editing: None), []),
    SaveEdit => match m.editing {
      None => Next(m, []),
      Some(f) => match check_title(f.title) {
        Err(e) => Next(m with (status: e), []),
        Ok(title) => Next(m with (editing: None), [
          ui_send("PUT", "/api/cards/{f.card_id}", json_of(CardEdit(title: title, notes: f.notes, assignee: parse_int(f.assignee))),
            fn(r) => Saved(r)),
        ]),
      },
    },
    Delete(card_id) => Next(with_cards(m, fn(cards) => filter(cards, fn(x) => x.id != card_id)) with (editing: None), [
      ui_send("DELETE", "/api/cards/{card_id}", JNull, fn(r) => PageReply(r)),
    ]),
    QueryTyped(t) => Next(m with (query: t), []),
    InviteTyped(t) => Next(m with (invite: t), []),
    SendInvite => match check_user_name(m.invite) {
      Err(e) => Next(m with (status: e), []),
      Ok(n) => Next(m with (invite: ""), [
        ui_send("POST", "/api/boards/{board_id(m)}/members", json_of(Invite(name: n)), fn(r) => PageReply(r)),
      ]),
    },
    PageReply(reply) => match read_page(reply) {
      Ok(page) => Next(m with (board: Some(page)), []),
      Err(e) => failed(m, e),
    },
    Saved(reply) => match ok_body(reply) {
      Ok(_) => Next(m, []),
      Err(e) => failed(m, e),
    },
    DismissStatus => Next(m with (status: ""), []),
  }
}

// A failed request: show why; a lost session sends you to the login page.
fn failed(m: Model, e: str) -> Next[Model, Msg] {
  if contains(e, "(401)") {
    return Next(empty_model() with (page: LoginPage, status: "please sign in again"), [ui_go("/login")])
  }
  return Next(m with (status: e), [])
}

fn login_problem(m: Model) -> Option[str] {
  if not m.signing_up {
    return if trim(m.name) == "" or m.password == "" then Some("enter your name and password") else None
  }
  return match check_user_name(m.name) {
    Err(e) => Some(e),
    Ok(_) => match check_password(m.password) { Err(e) => Some(e), Ok(_) => None },
  }
}

fn board_id(m: Model) -> int {
  return match m.page { BoardView(n) => n, _ => 0 }
}

fn with_cards(m: Model, change: fn(list[Card]) -> list[Card]) -> Model {
  return match m.board {
    None => m,
    Some(page) => m with (board: Some(page with (cards: change(page.cards)))),
  }
}

fn with_form(m: Model, change: fn(CardForm) -> CardForm) -> Model {
  return match m.editing { None => m, Some(f) => m with (editing: Some(change(f))) }
}

// ---- replies

fn ok_body(reply: Result[HttpResponse, str]) -> Result[str, str] {
  let res = reply?
  if res.status >= 300 {
    let why: Result[ApiError, str] = json_decode(res.body)
    return Err(match why { Ok(e) => "{e.error} ({res.status})", Err(_) => "the server answered {res.status}" })
  }
  return Ok(res.body)
}

fn read_user(reply: Result[HttpResponse, str]) -> Result[User, str] {
  return json_decode(ok_body(reply)?)
}

fn read_boards(reply: Result[HttpResponse, str]) -> Result[list[Board], str] {
  return json_decode(ok_body(reply)?)
}

fn read_board(reply: Result[HttpResponse, str]) -> Result[Board, str] {
  return json_decode(ok_body(reply)?)
}

fn read_page(reply: Result[HttpResponse, str]) -> Result[BoardPage, str] {
  return json_decode(ok_body(reply)?)
}

fn read_card(reply: Result[HttpResponse, str]) -> Result[Card, str] {
  return json_decode(ok_body(reply)?)
}

// ---- view

fn view(m: Model) -> Html[Msg] {
  return container([max_width(Wide)], [
    top_bar(m),
    if m.status == "" then nothing() else alert_dismissable([class("status")], Danger, m.status, [], DismissStatus),
    match m.page {
      Loading => center([], [spinner("Loading")]),
      LoginPage => login_view(m),
      BoardsPage => boards_view(m),
      BoardView(_) => match m.board { Some(page) => board_view(m, page), None => center([], [spinner("Loading the board")]) },
      Missing => box([max_width(Narrow), centered()], [
        empty_state("Not found", "This board does not exist, or you are not one of its members.",
          [a([href("/"), class("button v-outline")], [text("Back to your boards")])]),
      ]),
    },
  ])
}

fn top_bar(m: Model) -> Html[Msg] {
  return header([class("bar"), pad_x(Zero)], [spread([], [
    a([href("/"), class("brand")], [text("Klar Board")]),
    match m.me {
      None => nothing(),
      Some(u) => row([gap(Sm)], [avatar(u.name), span([class("muted")], [text(u.name)]),
        button([variant(Ghost), size(Small), on_click(LogOut)], [text("Log out")])]),
    },
  ])])
}

fn login_view(m: Model) -> Html[Msg] {
  return panel([max_width(Narrow), centered()], if m.signing_up then "Create an account" else "Sign in",
    if m.signing_up then "Pick a name and a password of at least 10 characters." else "Welcome back.", [
      form([on_submit(SubmitLogin)], [
        field("Name", input([id("name"), value(m.name), on_input(fn(s) => NameTyped(s)), attr("autocomplete", "username")])),
        field("Password", input([id("password"), input_type("password"), value(m.password), on_input(fn(s) => PasswordTyped(s)),
          attr("autocomplete", if m.signing_up then "new-password" else "current-password")])),
        button([input_type("submit"), class("wide")], [text(if m.signing_up then "Sign up" else "Sign in")]),
      ]),
    ], [button([variant(Link), on_click(ToggleSignUp)], [text(if m.signing_up then "I have an account" else "New here? Create an account")])])
}

fn boards_view(m: Model) -> Html[Msg] {
  return stack([max_width(Readable), centered()], [
    h1([], [text("Your boards")]),
    if len(m.boards) == 0 then empty_state("No boards yet", "Make one below, or ask a teammate to add you to theirs.", [])
      else grid([fit_cols(14), gap(Sm)], map(m.boards, fn(b) => a([href("/boards/{b.id}"), class("board-link card")], [h3([], [text(b.name)])]))),
    form([class("row"), on_submit(CreateBoard)], [
      input([id("new-board"), grow(), placeholder("New board name"), value(m.new_board), on_input(fn(s) => BoardNameTyped(s)),
        attr("aria-label", "new board name")]),
      button([input_type("submit")], [text("Create board")]),
    ]),
  ])
}

fn board_view(m: Model, page: BoardPage) -> Html[Msg] {
  let shown = search(page.cards, m.query)
  return stack([], [
    spread([], [
      stack([gap(Zero)], [h1([], [text(page.board.name)]), small([class("muted")], [text(summary(page.cards))])]),
      input([id("search"), max_width(Rem(16)), placeholder("Search cards"), value(m.query), on_input(fn(s) => QueryTyped(s)),
        attr("aria-label", "search cards")]),
    ]),
    match m.editing { None => nothing(), Some(f) => editor(f, page.members) },
    grid([cols(1), cols_at(Tablet, 3), gap(Sm)], map(columns(), fn(c) => column_view(m, page, shown, c))),
    grid([fit_cols(20), gap(Sm)], [members_view(m, page), activity_view(page.events)]),
  ])
}

fn column_view(m: Model, page: BoardPage, shown: list[Card], c: Column) -> Html[Msg] {
  let all = cards_in(page.cards, c)
  let visible = filter(all, fn(x) => any(shown, fn(s) => s.id == x.id))
  return stack([class("column"), gap(Sm), pad(Sm), attr("data-column", column_title(c)), on_drop(DropAt(c, 1000))], [
    spread([pad_x(Xs)], [h2([], [text(column_title(c))]), badge([], Neutral, str(len(all)))]),
    ul([class("plain stack"), gap(Sm)], map(visible, fn(x) => card_view(page, x, len(all)))),
    form([class("row add"), gap(Sm), on_submit(AddCard(c))], [
      input([grow(), placeholder("Add a card"), value(unwrap_or(get(m.drafts, column_title(c)), "")),
        on_input(fn(s) => DraftTyped(c, s)), attr("aria-label", "new card in {column_title(c)}")]),
      button([input_type("submit"), variant(Outline)], [text("Add")]),
    ]),
  ])
}

fn card_view(page: BoardPage, x: Card, column_size: int) -> Html[Msg] {
  let who = member_name(page.members, x.assignee)
  return li([class("kcard card"), attr("data-card", str(x.id)), on_drag(DragCard(x.id)), on_drag_end(DragEnded),
    on_drop(DropAt(x.column, x.position))], [
    button([variant(Ghost), class("title"), on_click(Edit(x))], [text(x.title)]),
    if x.notes == "" then nothing() else p([class("notes")], [text(x.notes)]),
    spread([], [
      if who == "" then span([], []) else badge([], Neutral, "@" + who),
      row([gap(Zero), no_wrap()], [
        move_button("←", "move left", match column_left(x.column) { Some(l) => Some(Move(x.id, l, 0)), None => None }),
        move_button("↑", "move up", if x.position > 0 then Some(Move(x.id, x.column, x.position - 1)) else None),
        move_button("↓", "move down", if x.position < column_size - 1 then Some(Move(x.id, x.column, x.position + 1)) else None),
        move_button("→", "move right", match column_right(x.column) { Some(r) => Some(Move(x.id, r, 0)), None => None }),
      ]),
    ]),
  ])
}

fn move_button(symbol: str, label_text: str, msg: Option[Msg]) -> Html[Msg] {
  return match msg {
    Some(go) => icon_button([size(Small), on_click(go)], label_text, symbol),
    None => icon_button([size(Small), disabled(true)], label_text, symbol),
  }
}

fn editor(f: CardForm, members: list[User]) -> Html[Msg] {
  return dialog(true, "Edit card", "", CancelEdit, [
    form([id("card-editor"), on_submit(SaveEdit)], [
      field("Title", input([id("edit-title"), value(f.title), on_input(fn(s) => EditTitle(s))])),
      field("Notes", textarea([id("edit-notes"), value(f.notes), on_input(fn(s) => EditNotes(s))], [])),
      field("Assigned to", select_box([id("edit-assignee")], [Choice("", "Nobody")] + map(members, fn(u) => Choice(str(u.id), u.name)),
        f.assignee, fn(s) => EditAssignee(s))),
    ]),
  ], [
    button([variant(Destructive), class("push-left"), on_click(Delete(f.card_id))], [text("Delete card")]),
    button([variant(Outline), on_click(CancelEdit)], [text("Cancel")]),
    button([input_type("submit"), attr("form", "card-editor")], [text("Save")]),
  ])
}

fn members_view(m: Model, page: BoardPage) -> Html[Msg] {
  return panel([], "Members", "Everyone here sees changes as they happen.", [
    ul([class("plain stack"), gap(Sm)], map(page.members, fn(u) => li([], [row([gap(Sm)], [avatar(u.name), text(u.name)])]))),
    form([class("row"), gap(Sm), on_submit(SendInvite)], [
      input([grow(), placeholder("Add someone by name"), value(m.invite), on_input(fn(s) => InviteTyped(s)),
        attr("aria-label", "member name")]),
      button([input_type("submit"), variant(Outline)], [text("Add")]),
    ]),
  ], [])
}

fn activity_view(events: list[Event]) -> Html[Msg] {
  return panel([], "Activity", "", [
    ul([class("plain activity")], map(events, fn(e) => li([], [span([class("who")], [text(e.user)]), text(" " + e.text)]))),
  ], [])
}

// Only the look of the board; layout comes from std.layout and components from std.kit.
fn app_css() -> str {
  return r"""
    .bar { border-bottom: 1px solid var(--border); }
    .brand { font-weight: 700; font-size: 1.05rem; text-decoration: none; letter-spacing: -0.02em; }
    .column { background: var(--subtle); border-radius: calc(var(--radius) * 1.5); }
    .column h2 { font-size: 0.875rem; margin: 0; }
    .kcard { padding: 0.625rem 0.75rem; }
    .kcard .title { height: auto; padding: 0.125rem 0.25rem; margin: -0.125rem -0.25rem; font-weight: 500;
      text-align: left; white-space: normal; justify-content: flex-start; }
    .kcard .notes { margin: 0.25rem 0; color: var(--muted); font-size: 0.875rem; white-space: pre-wrap; }
    .add input { height: 2rem; background: var(--bg); }
    .plain { list-style: none; padding: 0; margin: 0; }
    .activity li { padding: 0.25rem 0; font-size: 0.875rem; color: var(--muted); }
    .who { font-weight: 500; color: var(--fg); }
    .board-link { text-decoration: none; transition: border-color 0.15s; } .board-link:hover { border-color: var(--muted); }
    .board-link h3 { margin: 0; font-size: 1rem; }
    button.wide { width: 100%; align-self: stretch; }
    .push-left { margin-right: auto; }
  """
}

fn main() uses io {
  ui_start(init(), update, view, Some(fn(path) => UrlChanged(path)), html_theme_css() + kit_theme(default_theme()) + app_css())
}

// ---- tests (update and view are plain functions: no browser needed)

fn signed_in() -> Model {
  let cards = [Card(1, 7, "Write docs", "", Todo, 0, None), Card(2, 7, "Fix <login>", "Safari", Todo, 1, Some(2)),
    Card(3, 7, "Ship", "", Doing, 0, None)]
  let page = BoardPage(board: Board(7, "Launch", 1), members: [User(1, "ada"), User(2, "bob")], cards: cards,
    events: [Event(1, 7, "ada", "created the board", 0.0)])
  return empty_model() with (page: BoardView(7), me: Some(User(1, "ada")), board: Some(page), live: "/api/boards/7/live")
}

fn cards_of(m: Model) -> list[Card] {
  return match m.board { Some(bp) => bp.cards, None => [] }
}

test "urls map to pages" {
  assert page_of("/") == BoardsPage
  assert page_of("/login") == LoginPage
  assert page_of("/boards/12") == BoardView(12)
  assert page_of("/boards/x") == Missing
  assert page_of("/nope/1/2") == Missing
}

test "opening another board switches the live stream" {
  let next = update(signed_in(), UrlChanged("/boards/8"))
  assert next.model.live == "/api/boards/8/live"
  assert len(next.cmds) == 3          // stop the old stream, load the board, listen to the new one
  let home = update(signed_in(), UrlChanged("/"))
  assert home.model.live == ""
  assert home.model.board == None
}

test "dragging a card onto another card or a column moves it" {
  let held = update(signed_in(), DragCard(3)).model
  let onto = update(held, DropAt(Todo, 0))
  assert map(cards_in(cards_of(onto.model), Todo), fn(c) => c.id) == [3, 1, 2]
  assert onto.model.dragging == None
  assert len(onto.cmds) == 1
  let to_end = update(update(signed_in(), DragCard(1)).model, DropAt(Done, 1000)).model
  assert map(cards_in(cards_of(to_end), Done), fn(c) => c.id) == [1]
  assert len(update(signed_in(), DropAt(Done, 0)).cmds) == 0     // nothing held: nothing happens
}

test "a move shows at once, using the shared rule" {
  let next = update(signed_in(), Move(2, Doing, 0))
  assert map(cards_in(cards_of(next.model), Doing), fn(c) => c.id) == [2, 3]
  assert map(cards_in(cards_of(next.model), Todo), fn(c) => c.id) == [1]
  assert len(next.cmds) == 1
}

test "sign-up explains problems before sending" {
  let m = empty_model() with (page: LoginPage, signing_up: true, name: "a", password: "longenough")
  let next = update(m, SubmitLogin)
  assert next.model.status == "names are 2 to 30 characters"
  assert len(next.cmds) == 0
  assert len(update(m with (name: "ada"), SubmitLogin).cmds) == 1
}

test "a lost session goes back to login" {
  let reply = Ok(HttpResponse(401, [:], r"{\"error\": \"not signed in\"}"))
  let next = update(signed_in(), PageReply(reply))
  assert next.model.page == LoginPage
  assert next.model.me == None
}

test "server errors are shown with their reason" {
  let reply = Ok(HttpResponse(400, [:], r"{\"error\": \"only board members can be assigned\"}"))
  assert update(signed_in(), Saved(reply)).model.status == "only board members can be assigned (400)"
}

test "editing fills the form and saving sends it" {
  let editing = update(signed_in(), Edit(Card(2, 7, "Fix <login>", "Safari", Todo, 1, Some(2)))).model
  assert editing.editing == Some(CardForm(2, "Fix <login>", "Safari", "2"))
  let typed = update(editing, EditTitle("Fix login on Safari")).model
  let saved = update(typed, SaveEdit)
  assert saved.model.editing == None
  assert len(saved.cmds) == 1
}

test "the board view escapes text, filters by search and disables impossible moves" {
  let html = html_render(view(signed_in()))
  assert contains(html, "Fix &lt;login&gt;")
  assert contains(html, "2 to do, 1 doing, 0 done")
  assert contains(html, "@bob")
  let searched = html_render(view(signed_in() with (query: "safari")))
  assert not contains(searched, "Write docs")
  assert contains(searched, "Fix &lt;login&gt;")
}

test "live updates replace the board" {
  let m = signed_in()
  let data = r"""{"board": {"id": 7, "name": "Renamed", "owner_id": 1}, "members": [], "cards": [], "events": []}"""
  let next = update(m, Live(data)).model
  assert match next.board { Some(bp) => bp.board.name == "Renamed" and len(bp.cards) == 0, None => false }
}
