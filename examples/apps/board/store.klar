// Klar Board: everything stored in SQLite. Every query passes values as `?` parameters, and rows come back as
// the shared types by column name (sqlite_rows / sqlite_first).

use std.sqlite { Database, sqlite_open, sqlite_exec, sqlite_migrate, sqlite_rows, sqlite_first, sqlite_last_id, sql }
use std.time { time_now }
use shared { Column, Todo, Doing, Done, User, Board, Card, Event, BoardPage, move_card, cards_in }

// Each migration runs once, in order (sqlite_migrate); add new ones at the end.
fn migrations() -> list[str] {
  return [
    "create table users (id integer primary key, name text not null unique, password text not null)",
    "create table sessions (token_hash text primary key, user_id integer not null references users(id), created real not null)",
    "create table boards (id integer primary key, name text not null, owner_id integer not null references users(id))",
    "create table members (board_id integer not null references boards(id), user_id integer not null references users(id), primary key (board_id, user_id))",
    "create table cards (id integer primary key, board_id integer not null references boards(id), title text not null, notes text not null default '', col text not null, position integer not null, assignee integer references users(id))",
    "create table events (id integer primary key, board_id integer not null references boards(id), user text not null, text text not null, at real not null)",
    "create index cards_by_board on cards (board_id, col, position)",
    "create index events_by_board on events (board_id, id)",
    "update cards set col = case col when 'todo' then 'Todo' when 'doing' then 'Doing' when 'done' then 'Done' else col end",
  ]
}

fn store_open(path: str) -> Result[Database, str] uses io {
  let db = sqlite_open(path)?
  let _ = sqlite_exec(db, "pragma foreign_keys = on", [])?
  let _ = sqlite_migrate(db, migrations())?
  return Ok(db)
}

// ---- users and sessions

fn user_add(db: Database, name: str, password_hash: str) -> Result[User, str] uses io {
  let _ = sqlite_exec(db, "insert into users (name, password) values (?, ?)", [sql(name), sql(password_hash)])?
  return Ok(User(id: sqlite_last_id(db), name: name))
}

// A user with their stored password hash (kept on the server; never sent anywhere).
fn user_by_name(db: Database, name: str) -> Result[Option[(User, str)], str] uses io {
  let row: Option[(int, str, str)] = sqlite_first(db, "select id, name, password from users where name = ?", [sql(name)])?
  return Ok(match row { Some((id, n, hash)) => Some((User(id, n), hash)), None => None })
}

fn session_add(db: Database, token_hash: str, user_id: int) -> Result[unit, str] uses io {
  let _ = sqlite_exec(db, "insert into sessions (token_hash, user_id, created) values (?, ?, ?)",
    [sql(token_hash), sql(user_id), sql(time_now())])?
  return Ok(())
}

fn session_user(db: Database, token_hash: str) -> Result[Option[User], str] uses io {
  return sqlite_first(db, "select u.id, u.name from sessions s join users u on u.id = s.user_id where s.token_hash = ?",
    [sql(token_hash)])
}

fn session_delete(db: Database, token_hash: str) -> Result[unit, str] uses io {
  let _ = sqlite_exec(db, "delete from sessions where token_hash = ?", [sql(token_hash)])?
  return Ok(())
}

// ---- boards and members

fn board_add(db: Database, name: str, owner: User) -> Result[Board, str] uses io {
  let _ = sqlite_exec(db, "insert into boards (name, owner_id) values (?, ?)", [sql(name), sql(owner.id)])?
  let board = Board(id: sqlite_last_id(db), name: name, owner_id: owner.id)
  member_add(db, board.id, owner.id)?
  return Ok(board)
}

fn boards_of(db: Database, user_id: int) -> Result[list[Board], str] uses io {
  return sqlite_rows(db, "select b.id, b.name, b.owner_id from boards b join members m on m.board_id = b.id where m.user_id = ? order by b.id",
    [sql(user_id)])
}

fn board_find(db: Database, board_id: int) -> Result[Option[Board], str] uses io {
  return sqlite_first(db, "select id, name, owner_id from boards where id = ?", [sql(board_id)])
}

fn member_add(db: Database, board_id: int, user_id: int) -> Result[unit, str] uses io {
  let _ = sqlite_exec(db, "insert or ignore into members (board_id, user_id) values (?, ?)", [sql(board_id), sql(user_id)])?
  return Ok(())
}

fn members_of(db: Database, board_id: int) -> Result[list[User], str] uses io {
  return sqlite_rows(db, "select u.id, u.name from users u join members m on m.user_id = u.id where m.board_id = ? order by u.name",
    [sql(board_id)])
}

fn is_member(db: Database, board_id: int, user_id: int) -> Result[bool, str] uses io {
  let found: Option[int] = sqlite_first(db, "select 1 from members where board_id = ? and user_id = ?", [sql(board_id), sql(user_id)])?
  return Ok(is_some(found))
}

// ---- cards

fn cards_of(db: Database, board_id: int) -> Result[list[Card], str] uses io {
  return sqlite_rows(db, "select id, board_id, title, notes, col as column, position, assignee from cards where board_id = ? order by col, position",
    [sql(board_id)])
}

fn card_find(db: Database, card_id: int) -> Result[Option[Card], str] uses io {
  return sqlite_first(db, "select id, board_id, title, notes, col as column, position, assignee from cards where id = ?", [sql(card_id)])
}

// A new card goes to the end of its column.
fn card_add(db: Database, board_id: int, title: str, column: Column) -> Result[Card, str] uses io {
  let cards = cards_of(db, board_id)?
  let position = len(cards_in(cards, column))
  let _ = sqlite_exec(db, "insert into cards (board_id, title, col, position) values (?, ?, ?, ?)",
    [sql(board_id), sql(title), sql(column), sql(position)])?
  return Ok(Card(id: sqlite_last_id(db), board_id: board_id, title: title, notes: "", column: column, position: position,
    assignee: None))
}

fn card_edit(db: Database, card: Card) -> Result[unit, str] uses io {
  let _ = sqlite_exec(db, "update cards set title = ?, notes = ?, assignee = ? where id = ?",
    [sql(card.title), sql(card.notes), sql(card.assignee), sql(card.id)])?
  return Ok(())
}

// Move with the shared rule, then write every card whose column or position changed, in one transaction.
fn card_move(db: Database, card: Card, to: Column, position: int) -> Result[unit, str] uses io {
  let before = cards_of(db, card.board_id)?
  let after = move_card(before, card.id, to, position)
  let _ = sqlite_exec(db, "begin", [])?
  for c in after {
    let old = find(before, fn(b) => b.id == c.id)
    if old != Some(c) {
      match sqlite_exec(db, "update cards set col = ?, position = ? where id = ?",
        [sql(c.column), sql(c.position), sql(c.id)]) {
        Ok(_) => {}
        Err(e) => {
          let _ = sqlite_exec(db, "rollback", [])
          return Err(e)
        }
      }
    }
  }
  let _ = sqlite_exec(db, "commit", [])?
  return Ok(())
}

fn card_delete(db: Database, card: Card) -> Result[unit, str] uses io {
  let _ = sqlite_exec(db, "delete from cards where id = ?", [sql(card.id)])?
  let rest = filter(cards_of(db, card.board_id)?, fn(c) => c.column == card.column)
  var i = 0
  for c in cards_in(rest, card.column) {
    if c.position != i {
      let _ = sqlite_exec(db, "update cards set position = ? where id = ?", [sql(i), sql(c.id)])?
    }
    i = i + 1
  }
  return Ok(())
}

// ---- activity

fn event_add(db: Database, board_id: int, user: User, text: str) -> Result[unit, str] uses io {
  let _ = sqlite_exec(db, "insert into events (board_id, user, text, at) values (?, ?, ?, ?)",
    [sql(board_id), sql(user.name), sql(text), sql(time_now())])?
  return Ok(())
}

fn events_of(db: Database, board_id: int, limit: int) -> Result[list[Event], str] uses io {
  return sqlite_rows(db, "select id, board_id, user, text, at from events where board_id = ? order by id desc limit ?",
    [sql(board_id), sql(limit)])
}

fn board_page(db: Database, board: Board) -> Result[BoardPage, str] uses io {
  return Ok(BoardPage(board: board, members: members_of(db, board.id)?, cards: cards_of(db, board.id)?,
    events: events_of(db, board.id, 30)?))
}
