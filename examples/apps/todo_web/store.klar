// Data access for todos, backed by SQLite. Rows become Todo values by column name (sqlite_rows).

use std.sqlite { Database, sqlite_open, sqlite_exec, sqlite_rows, sqlite_last_id, sql }
use api { Todo }

fn store_open(path: str) -> Result[Database, str] uses io {
  let db = sqlite_open(path)?
  let _ = sqlite_exec(db, "create table if not exists todos (id integer primary key, title text not null, done integer not null default 0)", [])?
  return Ok(db)
}

fn store_list(db: Database) -> Result[list[Todo], str] uses io {
  return sqlite_rows(db, "select id, title, done from todos order by id", [])
}

fn store_add(db: Database, title: str) -> Result[Todo, str] uses io {
  let _ = sqlite_exec(db, "insert into todos (title) values (?)", [sql(title)])?
  return Ok(Todo(id: sqlite_last_id(db), title: title, done: false))
}

fn store_set_done(db: Database, id: int, done: bool) -> Result[bool, str] uses io {
  return Ok(sqlite_exec(db, "update todos set done = ? where id = ?", [sql(done), sql(id)])? > 0)
}

fn store_delete(db: Database, id: int) -> Result[bool, str] uses io {
  return Ok(sqlite_exec(db, "delete from todos where id = ?", [sql(id)])? > 0)
}
