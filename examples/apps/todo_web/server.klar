// Full-stack todo app, backend: typed calls (api.klar) on SQLite, and the browser app itself (app.klar).
//
//   klar dev examples/apps/todo_web/server.klar examples/apps/todo_web/app.klar     (rebuilds and reloads on save)
//
// or build it yourself:
//   klar build --target web examples/apps/todo_web/app.klar -o examples/apps/todo_web/app.html
//   klar build --target node examples/apps/todo_web/server.klar -o todo_server.mjs
//   APP_DIR=examples/apps/todo_web node todo_server.mjs        (or: klar run examples/apps/todo_web/server.klar)

use std.web { Route, web_get, web_serve, web_port, web_file, web_events, web_publish }
use std.api { ApiError, Refused, api_serve }
use std.json { json_encode }
use std.sqlite { Database }
use std.process { env_get }
use api { Todo, DoneChange, list_todos, add_todo, set_done, remove_todo }
use store { store_open, store_list, store_add, store_set_done, store_delete }

// Every browser listening on /api/live gets the full list after each change.
fn broadcast(db: Database) -> Result[unit, str] uses io {
  web_publish("todos", json_encode(store_list(db)?))
  return Ok(())
}

// In these handlers `?` turns a database error into Internal, which answers 500.
fn todos(db: Database) -> Result[list[Todo], ApiError] uses io {
  return Ok(store_list(db)?)
}

fn create(db: Database, title: str) -> Result[Todo, ApiError] uses io {
  if trim(title) == "" {
    return Err(Refused(400, "title is required"))
  }
  let todo = store_add(db, trim(title))?
  broadcast(db)?
  return Ok(todo)
}

fn change(db: Database, c: DoneChange) -> Result[unit, ApiError] uses io {
  if not store_set_done(db, c.id, c.done)? {
    return Err(Refused(404, "no such todo"))
  }
  broadcast(db)?
  return Ok(())
}

fn delete(db: Database, id: int) -> Result[unit, ApiError] uses io {
  if not store_delete(db, id)? {
    return Err(Refused(404, "no such todo"))
  }
  broadcast(db)?
  return Ok(())
}

fn routes(db: Database, dir: str) -> list[Route] {
  return [
    web_get("/", fn(req) => web_file(dir + "/app.html")),
    web_get("/api/live", fn(req) => web_events("todos")),
    api_serve(list_todos(), fn(req, nothing) => todos(db)),
    api_serve(add_todo(), fn(req, title) => create(db, title)),
    api_serve(set_done(), fn(req, c) => change(db, c)),
    api_serve(remove_todo(), fn(req, id) => delete(db, id)),
  ]
}

fn main() uses io {
  let port = web_port(8080)
  let db_path = unwrap_or(env_get("TODO_DB"), "todos.db")
  let dir = unwrap_or(env_get("APP_DIR"), ".")
  match store_open(db_path) {
    Err(e) => print("cannot open {db_path}: {e}"),
    Ok(db) => {
      print("todo app on http://127.0.0.1:{port}")
      match web_serve(port, routes(db, dir)) {
        Ok(_) => {}
        Err(e) => print("server error: {e}"),
      }
    }
  }
}
