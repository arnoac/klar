// Full-stack todo app, backend: a JSON API on SQLite that also serves the browser app (app.klar).
//
//   klar dev examples/apps/todo_web/server.klar examples/apps/todo_web/app.klar     (rebuilds and reloads on save)
//
// or build it yourself:
//   klar build --target web examples/apps/todo_web/app.klar -o examples/apps/todo_web/app.html
//   klar build --target node examples/apps/todo_web/server.klar -o todo_server.mjs
//   APP_DIR=examples/apps/todo_web node todo_server.mjs        (or: klar run examples/apps/todo_web/server.klar)
//
//   GET    /                 the app (app.html)
//   GET    /api/todos        all todos as JSON
//   POST   /api/todos        {"title": "..."}  -> the new todo
//   PUT    /api/todos/:id    {"done": true}    -> the updated todo
//   DELETE /api/todos/:id

use std.http { HttpRequest, HttpResponse }
use std.web { Route, web_get, web_post, web_put, web_delete, web_serve, web_port, web_file, web_json, web_body,
  web_events, web_publish }
use std.json { json_encode }
use std.sqlite { Database }
use std.process { env_get }
use api { Todo, NewTodo, DoneChange, ApiError }
use store { store_open, store_list, store_find, store_add, store_set_done, store_delete }

fn error_json(status: int, message: str) -> HttpResponse {
  return web_json(status, ApiError(error: message))
}

// Every browser listening on /api/live gets the full list after each change.
fn broadcast(db: Database) -> Result[unit, str] uses io {
  web_publish("todos", json_encode(store_list(db)?))
  return Ok(())
}

// Handlers return Result so `?` can be used; `respond` turns an Err into a 500.
fn respond(r: Result[HttpResponse, str]) -> HttpResponse {
  return match r { Ok(res) => res, Err(e) => error_json(500, e) }
}

fn list_todos(db: Database) -> Result[HttpResponse, str] uses io {
  return Ok(web_json(200, store_list(db)?))
}

fn create_todo(db: Database, req: HttpRequest) -> Result[HttpResponse, str] uses io {
  let body: Result[NewTodo, str] = web_body(req)
  let title = match body { Ok(b) => trim(b.title), Err(e) => { return Ok(error_json(400, e)) } }
  if title == "" {
    return Ok(error_json(400, "title is required"))
  }
  let todo = store_add(db, title)?
  broadcast(db)?
  return Ok(web_json(201, todo))
}

fn todo_id(req: HttpRequest) -> int {
  return unwrap_or(parse_int(req.params["id"]), 0)
}

fn update_todo(db: Database, req: HttpRequest) -> Result[HttpResponse, str] uses io {
  let body: Result[DoneChange, str] = web_body(req)
  match body {
    Err(e) => { return Ok(error_json(400, e)) }
    Ok(change) => {
      let _ = store_set_done(db, todo_id(req), change.done)?
      broadcast(db)?
    }
  }
  return match store_find(db, todo_id(req))? {
    Some(t) => Ok(web_json(200, t)),
    None => Ok(error_json(404, "no such todo")),
  }
}

fn delete_todo(db: Database, req: HttpRequest) -> Result[HttpResponse, str] uses io {
  if store_delete(db, todo_id(req))? {
    broadcast(db)?
    return Ok(web_json(200, ["deleted": true]))
  }
  return Ok(error_json(404, "no such todo"))
}

fn routes(db: Database, dir: str) -> list[Route] {
  return [
    web_get("/", fn(req) => web_file(dir + "/app.html")),
    web_get("/api/todos", fn(req) => respond(list_todos(db))),
    web_get("/api/live", fn(req) => web_events("todos")),
    web_post("/api/todos", fn(req) => respond(create_todo(db, req))),
    web_put("/api/todos/:id", fn(req) => respond(update_todo(db, req))),
    web_delete("/api/todos/:id", fn(req) => respond(delete_todo(db, req))),
  ]
}

fn main() uses io {
  let port = web_port(8080)
  let db_path = unwrap_or(env_get("TODO_DB"), "todos.db")
  let dir = unwrap_or(env_get("APP_DIR"), ".")
  match store_open(db_path) {
    Err(e) => print("cannot open {db_path}: {e}"),
    Ok(db) => {
      print("todo app on http://127.0.0.1:{port}")
      match web_serve(port, routes(db, dir)) {
        Ok(_) => {}
        Err(e) => print("server error: {e}"),
      }
    }
  }
}
