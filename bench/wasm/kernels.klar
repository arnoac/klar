// Compute kernels for the WebAssembly benchmark (bench/wasm/README.md). The algorithms are the Benchmarks Game
// programs in ../benchmarksgame, turned into functions that take a size and return their result.
// bench.klar runs every kernel twice: compiled to JavaScript (`use kernels`) and to WebAssembly
// (extern "wasm:kernels.<name>"); kernels.js is the same work written by hand in JavaScript.

struct System {
  x: list[float], y: list[float], z: list[float],
  vx: list[float], vy: list[float], vz: list[float],
  m: list[float],
}

fn pi() -> float { return 3.141592653589793 }
fn solar_mass() -> float { return 4.0 * pi() * pi() }
fn days_per_year() -> float { return 365.24 }

fn initial() -> System {
  let d = days_per_year()
  let sm = solar_mass()
  return System(
    x: [0.0, 4.84143144246472090e+00, 8.34336671824457987e+00, 1.28943695621391310e+01, 1.53796971148509165e+01],
    y: [0.0, -1.16032004402742839e+00, 4.12479856412430479e+00, -1.51111514016986312e+01, -2.59193146099879641e+01],
    z: [0.0, -1.03622044471123109e-01, -4.03523417114321381e-01, -2.23307578892655734e-01, 1.79258772950371181e-01],
    vx: [0.0, 1.66007664274403694e-03 * d, -2.76742510726862411e-03 * d, 2.96460137564761618e-03 * d, 2.68067772490389322e-03 * d],
    vy: [0.0, 7.69901118419740425e-03 * d, 4.99852801234917238e-03 * d, 2.37847173959480950e-03 * d, 1.62824170038242295e-03 * d],
    vz: [0.0, -6.90460016972063023e-05 * d, 2.30417297573763929e-05 * d, -2.96589568540237556e-05 * d, -9.51592254519715870e-05 * d],
    m: [sm, 9.54791938424326609e-04 * sm, 2.85885980666130812e-04 * sm, 4.36624404335156298e-05 * sm, 5.15138902046611451e-05 * sm],
  )
}

fn offset_momentum(s: System) -> System {
  var px = 0.0
  var py = 0.0
  var pz = 0.0
  for i in range(0, len(s.m)) {
    px = px + s.vx[i] * s.m[i]
    py = py + s.vy[i] * s.m[i]
    pz = pz + s.vz[i] * s.m[i]
  }
  let sm = solar_mass()
  return s with (vx: set_at(s.vx, 0, -px / sm), vy: set_at(s.vy, 0, -py / sm), vz: set_at(s.vz, 0, -pz / sm))
}

fn energy(s: System) -> float {
  var e = 0.0
  let n = len(s.m)
  for i in range(0, n) {
    e = e + 0.5 * s.m[i] * (s.vx[i] * s.vx[i] + s.vy[i] * s.vy[i] + s.vz[i] * s.vz[i])
    for j in range(i + 1, n) {
      let dx = s.x[i] - s.x[j]
      let dy = s.y[i] - s.y[j]
      let dz = s.z[i] - s.z[j]
      e = e - s.m[i] * s.m[j] / sqrt(dx * dx + dy * dy + dz * dz)
    }
  }
  return e
}

fn simulate(s: System, steps: int, dt: float) -> System {
  // The official algorithm: visit each pair once and update both bodies in place. The lists live in local
  // variables for the whole run, so every set_at writes straight into the buffer (see SPEC "Lists in loops").
  let n = len(s.m)
  let m = s.m
  var x = s.x
  var y = s.y
  var z = s.z
  var vx = s.vx
  var vy = s.vy
  var vz = s.vz
  for _step in range(0, steps) {
    for i in range(0, n) {
      for j in range(i + 1, n) {
        let dx = x[i] - x[j]
        let dy = y[i] - y[j]
        let dz = z[i] - z[j]
        let d2 = dx * dx + dy * dy + dz * dz
        let mag = dt / (d2 * sqrt(d2))
        let mi = m[i] * mag
        let mj = m[j] * mag
        vx = set_at(set_at(vx, i, vx[i] - dx * mj), j, vx[j] + dx * mi)
        vy = set_at(set_at(vy, i, vy[i] - dy * mj), j, vy[j] + dy * mi)
        vz = set_at(set_at(vz, i, vz[i] - dz * mj), j, vz[j] + dz * mi)
      }
    }
    for k in range(0, n) {
      x = set_at(x, k, x[k] + dt * vx[k])
      y = set_at(y, k, y[k] + dt * vy[k])
      z = set_at(z, k, z[k] + dt * vz[k])
    }
  }
  return System(x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, m: m)
}

// printf("%.9f") equivalent: Klar has no number formatting yet.
fn fixed(v: float, digits: int) -> str {
  var scale = 1
  for _i in range(0, digits) { scale = scale * 10 }
  let neg = v < 0.0
  let x = if neg then -v else v
  let n = round(x * to_float(scale))
  var frac = str(n % scale)
  while len(frac) < digits { frac = "0{frac}" }
  let sign = if neg and n != 0 then "-" else ""
  return "{sign}{n / scale}.{frac}"
}

fn nbody(steps: int) -> str {
  let s = offset_momentum(initial())
  return "{fixed(energy(s), 9)} {fixed(energy(simulate(s, steps, 0.01)), 9)}"
}

fn a(i: int, j: int) -> float {
  return 1.0 / to_float((i + j) * (i + j + 1) / 2 + i + 1)
}

fn mul_av(v: list[float]) -> list[float] {
  let n = len(v)
  var out: list[float] = []
  for i in range(0, n) {
    var sum = 0.0
    for j in range(0, n) { sum = sum + a(i, j) * v[j] }
    out = push(out, sum)
  }
  return out
}

fn mul_atv(v: list[float]) -> list[float] {
  let n = len(v)
  var out: list[float] = []
  for i in range(0, n) {
    var sum = 0.0
    for j in range(0, n) { sum = sum + a(j, i) * v[j] }
    out = push(out, sum)
  }
  return out
}

fn mul_atav(v: list[float]) -> list[float] {
  return mul_atv(mul_av(v))
}

fn spectralnorm(n: int) -> str {
  var u = map(range(0, n), fn(_i) => 1.0)
  var v: list[float] = []
  for _k in range(0, 10) {
    v = mul_atav(u)
    u = mul_atav(v)
  }
  var vbv = 0.0
  var vv = 0.0
  for i in range(0, n) {
    vbv = vbv + u[i] * v[i]
    vv = vv + v[i] * v[i]
  }
  return fixed(sqrt(vbv / vv), 9)
}

fn fannkuch(n: int) -> str {
  var perm1 = range(0, n)
  var count = map(range(0, n), fn(_i) => 0)
  var max_flips = 0
  var checksum = 0
  var perm_count = 0
  var r = n
  while true {
    while r != 1 {
      count = set_at(count, r - 1, r)
      r = r - 1
    }
    var perm = perm1
    var flips = 0
    var k = perm[0]
    while k != 0 {
      var i = 0
      var j = k
      while i < j {
        let t = perm[i]
        perm = set_at(perm, i, perm[j])
        perm = set_at(perm, j, t)
        i = i + 1
        j = j - 1
      }
      flips = flips + 1
      k = perm[0]
    }
    max_flips = max(max_flips, flips)
    checksum = if perm_count % 2 == 0 then checksum + flips else checksum - flips
    while true {
      if r == n {
        return "{checksum} Pfannkuchen({n}) = {max_flips}"
      }
      let perm0 = perm1[0]
      for i in range(0, r) {
        perm1 = set_at(perm1, i, perm1[i + 1])
      }
      perm1 = set_at(perm1, r, perm0)
      count = set_at(count, r, count[r] - 1)
      if count[r] > 0 { break }
      r = r + 1
    }
    perm_count = perm_count + 1
  }
  return ""
}

fn mandelbrot(size: int) -> int {
  var hash = 0
  var bits = 0
  var nbits = 0
  for y in range(0, size) {
    let ci = 2.0 * to_float(y) / to_float(size) - 1.0
    for x in range(0, size) {
      let cr = 2.0 * to_float(x) / to_float(size) - 1.5
      var zr = 0.0
      var zi = 0.0
      var tr = 0.0
      var ti = 0.0
      var i = 0
      while i < 50 and tr + ti <= 4.0 {
        zi = 2.0 * zr * zi + ci
        zr = tr - ti + cr
        tr = zr * zr
        ti = zi * zi
        i = i + 1
      }
      bits = bits * 2 + (if tr + ti <= 4.0 then 1 else 0)
      nbits = nbits + 1
      if nbits == 8 or x == size - 1 {
        while nbits < 8 {
          bits = bits * 2
          nbits = nbits + 1
        }
        hash = (hash * 31 + bits) % 1000000007
        bits = 0
        nbits = 0
      }
    }
  }
  return hash
}

enum Tree { Leaf, Node(left: Tree, right: Tree) }

fn bottom_up(depth: int) -> Tree {
  if depth > 0 { return Node(bottom_up(depth - 1), bottom_up(depth - 1)) }
  return Node(Leaf, Leaf)
}

fn check(t: Tree) -> int {
  return match t {
    Leaf => 0,
    Node(l, r) => 1 + check(l) + check(r),
  }
}

fn pow2(k: int) -> int {
  var p = 1
  for _i in range(0, k) { p = p * 2 }
  return p
}

fn binarytrees(n: int) -> int {
  let min_depth = 4
  let max_depth = max(min_depth + 2, n)
  var total = check(bottom_up(max_depth + 1))
  let long_lived = bottom_up(max_depth)
  var d = min_depth
  while d <= max_depth {
    let iterations = pow2(max_depth - d + min_depth)
    for _i in range(0, iterations) { total = total + check(bottom_up(d)) }
    d = d + 2
  }
  return total + check(long_lived)
}

// Data in and out: a list of floats crosses the JavaScript <-> WebAssembly boundary both ways.
fn smooth(xs: list[float], passes: int) -> list[float] {
  let n = len(xs)
  var cur = xs
  for _p in range(0, passes) {
    var next = cur
    for i in range(1, n - 1) {
      next = set_at(next, i, (cur[i - 1] + 2.0 * cur[i] + cur[i + 1]) / 4.0)
    }
    cur = next
  }
  return cur
}
