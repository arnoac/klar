fn main() uses io {
  var seed = 42
  var counts: map[str, int] = [:]
  for i in range(0, 2000000) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    let word = "w{seed % 5000}"
    counts = put(counts, word, unwrap_or(get(counts, word), 0) + 1)
  }
  var best = ""
  var best_n = 0
  for w in keys(counts) {
    if counts[w] > best_n {
      best = w
      best_n = counts[w]
    }
  }
  print("{len(counts)} {best} {best_n}")
}
