// spectral-norm (Computer Language Benchmarks Game): power method on the infinite matrix A.
fn a(i: int, j: int) -> float {
  return 1.0 / to_float((i + j) * (i + j + 1) / 2 + i + 1)
}

fn mul_av(v: list[float]) -> list[float] {
  let n = len(v)
  var out: list[float] = []
  for i in range(0, n) {
    var sum = 0.0
    for j in range(0, n) { sum = sum + a(i, j) * v[j] }
    out = push(out, sum)
  }
  return out
}

fn mul_atv(v: list[float]) -> list[float] {
  let n = len(v)
  var out: list[float] = []
  for i in range(0, n) {
    var sum = 0.0
    for j in range(0, n) { sum = sum + a(j, i) * v[j] }
    out = push(out, sum)
  }
  return out
}

fn mul_atav(v: list[float]) -> list[float] {
  return mul_atv(mul_av(v))
}

fn fixed(v: float, digits: int) -> str {
  var scale = 1
  for _i in range(0, digits) { scale = scale * 10 }
  let neg = v < 0.0
  let x = if neg then -v else v
  let n = round(x * to_float(scale))
  var frac = str(n % scale)
  while len(frac) < digits { frac = "0{frac}" }
  let sign = if neg and n != 0 then "-" else ""
  return "{sign}{n / scale}.{frac}"
}

fn main() uses io {
  let args_ = args()
  let n = if len(args_) > 0 then unwrap_or(parse_int(args_[0]), 100) else 100
  var u = map(range(0, n), fn(_i) => 1.0)
  var v: list[float] = []
  for _k in range(0, 10) {
    v = mul_atav(u)
    u = mul_atav(v)
  }
  var vbv = 0.0
  var vv = 0.0
  for i in range(0, n) {
    vbv = vbv + u[i] * v[i]
    vv = vv + v[i] * v[i]
  }
  print(fixed(sqrt(vbv / vv), 9))
}
